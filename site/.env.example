R2_PUBLIC_BASE=https://media.example.com

# Used ONLY by the local dev server (npm run dev) for the internal fragment
# inbox's Transcribe / Fix-grammar buttons. Read server-side by
# src/dev/openrouter-plugin.mjs — never sent to the browser, never in the build.
# Get one at https://openrouter.ai/keys . Optional: the inbox works without it,
# those two buttons just report that the key is missing.
OPENROUTER_API_KEY=sk-or-your-key-here
