R2_PUBLIC_BASE=https://media.example.com

# Used ONLY by the local dev server (npm run dev) for the internal fragment
# inbox's Transcribe / Fix-grammar buttons. Read server-side by
# src/dev/openrouter-plugin.mjs — never sent to the browser, never in the build.
# Get one at https://openrouter.ai/keys . Optional: the inbox works without it,
# those two buttons just report that the key is missing.
OPENROUTER_API_KEY=sk-or-your-key-here

# Reference voice clip for the inbox "generate voice" button (fish-audio voice
# cloning). Point it at a clean recording of your voice; it's auto-trimmed to a
# short mono WAV and transcribed once per session. Optional VOICE_REF_TEXT skips
# the auto-transcription by giving the reference's exact words.
VOICE_REF_AUDIO=C:/path/to/your/voice-sample.mp3
# VOICE_REF_TEXT=what you said in the reference clip
