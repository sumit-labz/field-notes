---
// /internal/fragments — a working inbox for Sumit, NOT a public reader page.
//
// Deliberately outside the site's design system (docs/design/IMPLEMENTATION-
// SPEC.md governs the public reader; this tool does not follow it). Optimized
// purely for fast scanning and copy-pasting fragment IDs into Claude Code.
//
// PRIVACY: this route is LOCAL-ONLY by default. The internalRoutePrivacy()
// integration in astro.config.mjs strips /internal/* from the production build,
// so it is never deployed to GitHub Pages — a 404 for everyone. It exists only
// under `npm run dev`. Setting EXPOSE_INTERNAL=true (a manual toggle in
// build.yml) keeps it in a deploy on demand, e.g. while travelling; a normal
// push re-privatises it. Even when exposed it is view-only — the transcribe/
// fix/delete endpoints are dev-server middleware, absent from a static deploy.
// It also carries a robots noindex and is unlinked from nav. (No sitemap.xml or
// RSS feed exists; if either is added, exclude this route there too.)
import { getCollection } from 'astro:content';
import { formatCapturedAt } from '../../lib/dates';
import { mediaUrl } from '../../lib/media-url';
import { isLocalMedia, localMediaUrl } from '../../lib/local-media';

const TYPE_ICON: Record<string, string> = {
  photo: '🖼️',
  video: '🎬',
  audio: '🎙️',
  text: '📝',
};

// One preview per media item. Kind is derived from the KEY itself (its
// media/{photo,audio,video}/ prefix, or an R2 key = photo), independent of the
// fragment's `type` field — so a fragment that ended up with mixed media (e.g.
// the bot grouping a photo with a voice note) still surfaces every item.
type Preview =
  | { kind: 'photo'; src: string; raw: string }
  | { kind: 'video'; src: string }
  | { kind: 'audio'; src: string }
  | { kind: 'missing'; path: string };

function mediaPreviews(media: string[] | undefined): Preview[] {
  if (!media) return [];
  return media.map((key): Preview => {
    if (isLocalMedia(key)) {
      const src = localMediaUrl(key);
      if (!src) return { kind: 'missing', path: key };
      if (key.startsWith('media/audio/')) return { kind: 'audio', src };
      if (key.startsWith('media/video/')) return { kind: 'video', src };
      return { kind: 'photo', src, raw: src }; // media/photo/
    }
    // R2 key → photo (bot uploads).
    const src = mediaUrl(key);
    return { kind: 'photo', src, raw: src };
  });
}

function textExcerpt(body: string): string {
  const trimmed = body.trim();
  return trimmed.length > 100 ? trimmed.slice(0, 100) + '…' : trimmed;
}

const fragments = await getCollection('fragments');

const rows = fragments
  .map((f) => ({
    id: f.data.id,
    date: f.data.id.slice(0, 10), // fragments/YYYY-MM-DD/… — folder == group key
    capturedAt: f.data.captured_at,
    type: f.data.type,
    journey: f.data.journey,
    spark: f.data.spark,
    consumedBy: f.data.consumed_by,
    // Full body, used by the Fix-grammar button on text rows (the preview only
    // carries a 100-char excerpt).
    fullText: (f.body ?? '').trim(),
    previews: mediaPreviews(f.data.media),
    excerpt: textExcerpt(f.body ?? ''),
  }))
  .sort((a, b) => b.capturedAt.valueOf() - a.capturedAt.valueOf());

// Group by capture date, newest date first (rows already sorted newest-first).
const groups: { date: string; items: typeof rows }[] = [];
for (const row of rows) {
  let group = groups.find((g) => g.date === row.date);
  if (!group) {
    group = { date: row.date, items: [] };
    groups.push(group);
  }
  group.items.push(row);
}

const total = rows.length;
const unassignedCount = rows.filter((r) => r.journey === null).length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>fragment inbox (internal)</title>
    <style>
      :root {
        --bg: #f7f7f5;
        --panel: #ffffff;
        --border: #d9d9d4;
        --text: #1c1c1a;
        --muted: #6b6b64;
        --accent: #2563eb;
        --spark: #d97706;
        --stub-bg: #f0f0ee;
        --stub-text: #9a9a92;
        --danger: #b91c1c;
        --danger-bg: #fbeaea;
        --just-bg: #e8f0ff;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #17171a;
          --panel: #1f1f23;
          --border: #34343a;
          --text: #e6e6e2;
          --muted: #9a9a92;
          --accent: #6ea8ff;
          --spark: #f5b23d;
          --danger: #f87171;
          --danger-bg: #2a1717;
          --just-bg: #1b2740;
          --stub-bg: #26262b;
          --stub-text: #6b6b64;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        font-size: 14px;
        line-height: 1.45;
      }
      code, .mono {
        font-family: 'SFMono-Regular', ui-monospace, 'Cascadia Code', Menlo, Consolas, monospace;
      }
      header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: var(--panel);
        border-bottom: 1px solid var(--border);
        padding: 12px max(20px, calc((100% - 1180px) / 2));
      }
      .title-row {
        display: flex;
        align-items: baseline;
        gap: 12px;
        flex-wrap: wrap;
      }
      h1 { font-size: 16px; margin: 0; font-weight: 600; }
      .counts { color: var(--muted); font-size: 12px; }
      .controls {
        display: flex;
        gap: 16px;
        align-items: center;
        flex-wrap: wrap;
        margin-top: 10px;
      }
      .controls label { color: var(--muted); font-size: 12px; margin-right: 4px; }
      select {
        font: inherit;
        font-size: 13px;
        padding: 3px 6px;
        background: var(--bg);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 4px;
      }
      button {
        font: inherit;
        cursor: pointer;
        border: 1px solid var(--border);
        background: var(--panel);
        color: var(--text);
        border-radius: 6px;
        padding: 5px 10px;
        font-size: 12px;
      }
      button:hover { border-color: var(--accent); color: var(--accent); }
      .primary {
        background: var(--accent);
        color: #fff;
        border-color: var(--accent);
      }
      .selbar {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 10px;
        font-size: 12px;
        color: var(--muted);
      }
      main { padding: 20px max(20px, calc((100% - 1180px) / 2)) 80px; }
      .date-group { margin-top: 28px; }
      .date-head {
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 10px;
        padding-left: 2px;
      }
      .row {
        display: grid;
        grid-template-columns: 24px minmax(150px, 240px) 1fr;
        gap: 16px;
        align-items: start;
        padding: 16px;
        margin-bottom: 10px;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 12px;
      }
      .row:hover { border-color: var(--accent); }
      .row.hidden { display: none; }
      .row.just-added {
        border-color: var(--accent);
        box-shadow: 0 0 0 1px var(--accent), inset 3px 0 0 var(--accent);
      }
      .just-badge {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--accent);
        border: 1px solid var(--accent);
        border-radius: 3px;
        padding: 0 5px;
        margin-left: 6px;
      }
      .row-check { margin-top: 4px; }
      .preview { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
      .thumb {
        max-width: 100%;
        max-height: 130px;
        border-radius: 6px;
        border: 1px solid var(--border);
        display: block;
      }
      .av { max-width: 100%; width: 100%; display: block; }
      audio.av { height: 36px; }
      /* Compact custom audio player (replaces the clunky native controls). */
      .aplayer {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
      }
      .aplayer audio { display: none; }
      .aplayer-play {
        flex: none;
        width: 28px;
        height: 28px;
        padding: 0;
        display: grid;
        place-items: center;
        border-radius: 50%;
        border: none;
        color: var(--panel);
        background: var(--text);
      }
      .aplayer-play:hover { color: var(--panel); border: none; }
      .aplayer-play .ic-play { margin-left: 1px; }
      .aplayer-play .ic-pause { display: none; }
      .aplayer.playing .aplayer-play .ic-play { display: none; }
      .aplayer.playing .aplayer-play .ic-pause { display: block; }
      .aplayer-track {
        flex: 1;
        height: 4px;
        min-width: 40px;
        border-radius: 2px;
        background: var(--border);
        cursor: pointer;
        position: relative;
      }
      .aplayer-fill { height: 100%; width: 0%; border-radius: 2px; background: var(--accent); }
      .aplayer-time { flex: none; font-size: 11px; color: var(--muted); white-space: nowrap; }
      .excerpt {
        color: var(--text);
        font-size: 13px;
        white-space: pre-wrap;
      }
      .excerpt.empty { color: var(--muted); font-style: italic; }
      .missing { color: var(--spark); font-size: 12px; }
      .meta {
        display: flex;
        flex-direction: column;
        gap: 5px;
        min-width: 0;
      }
      .id-line {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
      }
      .id {
        font-size: 13px;
        font-weight: 600;
        user-select: all;
        cursor: text;
      }
      .copy-btn { padding: 2px 7px; font-size: 11px; }
      .copied { border-color: var(--accent); color: var(--accent); }
      .del-btn {
        padding: 2px 7px;
        font-size: 11px;
        color: var(--danger);
        border-color: transparent;
        background: transparent;
      }
      .del-btn:hover { border-color: var(--danger); }
      .del-confirm {
        margin-top: 6px;
        padding: 8px 10px;
        border: 1px solid var(--danger);
        border-radius: 5px;
        background: var(--danger-bg);
        font-size: 12px;
        max-width: 440px;
      }
      .del-confirm p { margin: 0 0 6px; color: var(--text); }
      .del-confirm input {
        font: inherit;
        font-size: 12px;
        padding: 3px 6px;
        width: 190px;
        border: 1px solid var(--border);
        border-radius: 4px;
        background: var(--panel);
        color: var(--text);
      }
      .del-confirm .del-go {
        color: #fff;
        background: var(--danger);
        border-color: var(--danger);
      }
      .del-confirm .del-go:disabled { opacity: 0.5; cursor: not-allowed; }
      .del-confirm .row-actions { display: flex; gap: 6px; margin-top: 7px; align-items: center; }
      .del-confirm .del-status { font-size: 11px; color: var(--danger); }
      .tags {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        align-items: center;
        color: var(--muted);
        font-size: 12px;
      }
      .type-tag { color: var(--text); }
      .journey-tag code { color: var(--text); }
      .journey-tag.unassigned { color: var(--muted); font-style: italic; }
      .spark-tag { color: var(--spark); font-weight: 600; }
      .consumed { color: var(--muted); font-size: 11px; }
      .tools { margin-top: 4px; }
      .tool-buttons, .result-actions { display: flex; gap: 6px; flex-wrap: wrap; }
      .tool-btn {
        background: var(--stub-bg);
        color: var(--text);
        border: 1px solid var(--border);
        font-size: 11px;
        padding: 3px 9px;
      }
      .tool-btn:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
      .tool-btn:disabled { cursor: progress; color: var(--stub-text); }
      .tool-btn.subtle { color: var(--muted); }
      .tool-status {
        font-size: 11px;
        margin-top: 5px;
        color: var(--muted);
      }
      .tool-status.error { color: var(--spark); }
      .tbox { margin-top: 8px; }
      .tbox-label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted);
        margin-bottom: 3px;
      }
      .tbox-hint { text-transform: none; letter-spacing: 0; font-style: italic; }
      .tbox-cost, .voice-cost { text-transform: none; letter-spacing: 0; color: var(--accent); margin-left: 6px; }
      .voice-box { margin-top: 8px; max-width: 520px; }
      .voice-box .aplayer { margin-top: 4px; }
      #session-cost { color: var(--accent); }
      .transcript-text, .fixed-text {
        width: 100%;
        max-width: 520px;
        font-size: 12px;
        line-height: 1.45;
        color: var(--text);
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 6px 8px;
        resize: vertical;
        display: block;
        margin-bottom: 5px;
      }
      .transcript-text { color: var(--muted); background: var(--bg); }
      .empty-state { color: var(--muted); margin-top: 40px; }
      a { color: var(--accent); }
      .capture {
        border-bottom: 1px solid var(--border);
        background: var(--panel);
        padding: 12px max(20px, calc((100% - 1180px) / 2));
      }
      .capture-row {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
      }
      .capture-row .upload-label {
        font-size: 12px;
        border: 1px solid var(--border);
        background: var(--bg);
        border-radius: 4px;
        padding: 4px 9px;
        cursor: pointer;
      }
      .capture-row .upload-label:hover { border-color: var(--accent); }
      #rec-btn.recording { background: var(--danger); color: #fff; border-color: var(--danger); }
      #note-input {
        font: inherit;
        font-size: 13px;
        padding: 4px 8px;
        min-width: 200px;
        flex: 1;
        max-width: 340px;
        border: 1px solid var(--border);
        border-radius: 4px;
        background: var(--bg);
        color: var(--text);
      }
      .capture-hint { color: var(--muted); font-size: 12px; }
      #capture-status { font-size: 12px; }
      #capture-status.error { color: var(--danger); }
      .settings { margin-top: 10px; font-size: 12px; }
      .settings > summary {
        cursor: pointer;
        color: var(--muted);
        user-select: none;
        width: fit-content;
      }
      .settings > summary:hover { color: var(--text); }
      .settings-body {
        margin-top: 8px;
        padding: 10px 12px;
        border: 1px solid var(--border);
        border-radius: 6px;
        max-width: 640px;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .model-line { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
      .model-label {
        display: inline-block;
        min-width: 84px;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-size: 10px;
      }
      .model-line code { color: var(--text); font-size: 12px; }
      .model-note { color: var(--muted); font-size: 11px; }
      .prompt-label { color: var(--muted); font-size: 11px; margin-top: 4px; }
      #fix-prompt {
        width: 100%;
        font-size: 12px;
        line-height: 1.45;
        color: var(--text);
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 8px;
        resize: vertical;
      }
      .prompt-actions { display: flex; gap: 8px; align-items: center; }
    </style>
  </head>
  <body>
    <header>
      <div class="title-row">
        <h1>fragment inbox</h1>
        <span class="counts">
          {total} fragments · {unassignedCount} unassigned · internal / not indexed
        </span>
        <button id="pull-btn" class="tool-btn" type="button">⟳ pull latest</button>
        <button id="fetch-btn" class="tool-btn" type="button" title="Trigger the Telegram ingest Action on GitHub, wait for it, then pull. Takes ~1–2 min.">⤓ fetch from Telegram</button>
        <span id="pull-status" class="counts"></span>
        <span id="session-cost" class="counts" title="Approx OpenRouter spend this browser session"></span>
      </div>
      <div class="controls">
        <div>
          <label for="filter-type">type</label>
          <select id="filter-type">
            <option value="all">all</option>
            <option value="photo">photo</option>
            <option value="video">video</option>
            <option value="audio">audio</option>
            <option value="text">text</option>
          </select>
        </div>
        <div>
          <label for="filter-assigned">journey</label>
          <select id="filter-assigned">
            <option value="all">all</option>
            <option value="unassigned">unassigned</option>
            <option value="assigned">assigned</option>
          </select>
        </div>
        <span class="counts" id="visible-count"></span>
      </div>
      <div class="selbar">
        <button id="copy-selected" class="primary">copy selected IDs</button>
        <button id="select-visible">select all visible</button>
        <button id="clear-sel">clear</button>
        <span id="sel-count">0 selected</span>
      </div>
    </header>

    <section class="capture">
      <div class="capture-row">
        <button id="rec-btn" class="tool-btn" type="button">● record audio</button>
        <label class="upload-label">⤴ upload photo/video
          <input id="file-input" type="file" accept="image/*,video/*" multiple hidden />
        </label>
        <span class="capture-hint">or paste a screenshot (Ctrl/⌘+V anywhere)</span>
        <input id="note-input" type="text" placeholder="optional note for the next capture…" />
        <span id="capture-status"></span>
      </div>
      <details class="settings">
        <summary>⚙ models &amp; grammar prompt</summary>
        <div class="settings-body">
          <div class="model-line">
            <span class="model-label">transcribe</span>
            <code id="transcribe-model">…</code>
            <span class="model-note">(no prompt — audio in, text out)</span>
          </div>
          <div class="model-line">
            <span class="model-label">fix grammar</span>
            <code id="fix-model">…</code>
          </div>
          <label class="prompt-label" for="fix-prompt">grammar prompt (editable · saved in this browser)</label>
          <textarea id="fix-prompt" class="mono" rows="8" spellcheck="false" placeholder="loading default prompt…"></textarea>
          <div class="prompt-actions">
            <button id="prompt-reset" class="tool-btn subtle" type="button">reset to default</button>
            <span id="prompt-saved" class="model-note"></span>
          </div>
        </div>
      </details>
    </section>

    <main>
      {
        total === 0 ? (
          <p class="empty-state">No fragments yet.</p>
        ) : (
          groups.map((group) => (
            <section class="date-group">
              <div class="date-head">{group.date}</div>
              {group.items.map((row) => (
                <div
                  class="row"
                  data-type={row.type}
                  data-assigned={row.journey === null ? 'unassigned' : 'assigned'}
                  data-id={row.id}
                >
                  <input class="row-check" type="checkbox" aria-label={`select ${row.id}`} />

                  <div class="preview">
                    {row.previews.map((preview) => (
                      <>
                        {preview.kind === 'photo' && (
                          <a href={preview.raw} target="_blank" rel="noreferrer">
                            <img class="thumb" src={preview.src} alt={row.id} loading="lazy" />
                          </a>
                        )}
                        {preview.kind === 'video' && (
                          <video class="av" controls preload="metadata" src={preview.src} />
                        )}
                        {preview.kind === 'audio' && (
                          <div class="aplayer" data-aplayer>
                            <button class="aplayer-play" type="button" aria-label="Play">
                              <svg class="ic-play" width="11" height="12" viewBox="0 0 11 12" aria-hidden="true"><path d="M1 1 L10 6 L1 11 Z" fill="currentColor" /></svg>
                              <svg class="ic-pause" width="11" height="12" viewBox="0 0 11 12" aria-hidden="true"><rect x="1" y="1" width="3" height="10" fill="currentColor" /><rect x="7" y="1" width="3" height="10" fill="currentColor" /></svg>
                            </button>
                            <div class="aplayer-track"><div class="aplayer-fill" /></div>
                            <span class="aplayer-time mono">0:00</span>
                            <audio preload="metadata" src={preview.src} />
                          </div>
                        )}
                        {preview.kind === 'missing' && (
                          <div class="missing">⚠ file not found: <code>{preview.path}</code></div>
                        )}
                      </>
                    ))}
                    {row.previews.length === 0 && (
                      <div class={`excerpt${row.excerpt ? '' : ' empty'}`}>
                        {row.excerpt || '(no text)'}
                      </div>
                    )}
                  </div>

                  <div class="meta">
                    <div class="id-line">
                      <code class="id mono">{row.id}</code>
                      <button class="copy-btn" data-copy-id={row.id}>copy</button>
                      <button class="del-btn" type="button" data-del-id={row.id}>delete</button>
                    </div>
                    <div class="tags">
                      <span class="type-tag">{TYPE_ICON[row.type] ?? ''} {row.type}</span>
                      <span>· {formatCapturedAt(row.capturedAt)}</span>
                      {row.journey === null ? (
                        <span class="journey-tag unassigned">· unassigned</span>
                      ) : (
                        <span class="journey-tag">
                          · <code>{row.journey}</code>
                        </span>
                      )}
                      {row.spark && <span class="spark-tag">· ★ spark</span>}
                    </div>
                    {row.consumedBy && (
                      <div class="consumed">consumed by: <code>{row.consumedBy}</code></div>
                    )}
                    {(row.type === 'audio' || row.type === 'text') && (
                      <div class="tools" data-tools-id={row.id} data-tools-type={row.type}>
                        <div class="tool-buttons">
                          {row.type === 'audio' && (
                            <button class="tool-btn" type="button" data-action="transcribe">
                              Transcribe
                            </button>
                          )}
                          {row.type === 'text' && (
                            <button class="tool-btn" type="button" data-action="fix" data-source="body">
                              Fix grammar
                            </button>
                          )}
                        </div>
                        {row.type === 'text' && (
                          <div class="src-text" hidden>{row.fullText}</div>
                        )}
                        <div class="tool-status" role="status" hidden></div>

                        {row.type === 'audio' && (
                          <div class="tbox transcript-box" hidden>
                            <div class="tbox-label">transcribed <span class="tbox-hint">· read-only</span><span class="tbox-cost"></span></div>
                            <textarea class="transcript-text mono" rows="4" readonly spellcheck="false"></textarea>
                            <div class="result-actions">
                              <button class="tool-btn" type="button" data-action="fix" data-source="transcript">Fix grammar</button>
                              <button class="tool-btn" type="button" data-action="copy-transcript">copy</button>
                              <button class="tool-btn" type="button" data-action="save-transcript">save</button>
                            </div>
                          </div>
                        )}

                        <div class="tbox fixed-box" hidden>
                          <div class="tbox-label">after grammar<span class="tbox-cost"></span></div>
                          <textarea class="fixed-text mono" rows="4" spellcheck="false"></textarea>
                          <div class="result-actions">
                            <button class="tool-btn" type="button" data-action="copy-fixed">copy</button>
                            <button class="tool-btn" type="button" data-action="save-cleaned">save</button>
                            {row.type === 'audio' && (
                              <button class="tool-btn" type="button" data-action="generate-voice">🔊 generate voice</button>
                            )}
                            <button class="tool-btn subtle" type="button" data-action="clear-fixed">clear</button>
                          </div>
                          <div class="voice-box" hidden>
                            <div class="tbox-label">voice<span class="voice-cost"></span></div>
                            <div class="voice-player"></div>
                          </div>
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </section>
          ))
        )
      }
    </main>

    <script>
      // Clipboard + filtering for the internal inbox. Plain DOM, no framework —
      // this page is a local tool, function over polish.

      async function copyText(text: string): Promise<boolean> {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          // Clipboard API needs a secure context (localhost counts). Fall back
          // to the legacy path so copy still works over plain http if needed.
          try {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            const ok = document.execCommand('copy');
            document.body.removeChild(ta);
            return ok;
          } catch {
            return false;
          }
        }
      }

      function flash(btn: HTMLElement, label: string) {
        const prev = btn.textContent;
        btn.textContent = label;
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = prev;
          btn.classList.remove('copied');
        }, 1000);
      }

      // Per-row copy.
      document.querySelectorAll<HTMLButtonElement>('[data-copy-id]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-copy-id') ?? '';
          const ok = await copyText(id);
          flash(btn, ok ? 'copied ✓' : 'failed');
        });
      });

      const rows = Array.from(document.querySelectorAll<HTMLElement>('.row'));
      const checks = () =>
        rows.map((r) => r.querySelector<HTMLInputElement>('.row-check')!);

      // Filters.
      const typeSel = document.getElementById('filter-type') as HTMLSelectElement;
      const assignedSel = document.getElementById('filter-assigned') as HTMLSelectElement;
      const visibleCount = document.getElementById('visible-count')!;

      function isVisible(row: HTMLElement): boolean {
        const t = typeSel.value;
        const a = assignedSel.value;
        if (t !== 'all' && row.dataset.type !== t) return false;
        if (a !== 'all' && row.dataset.assigned !== a) return false;
        return true;
      }

      function applyFilter() {
        let shown = 0;
        for (const row of rows) {
          const vis = isVisible(row);
          row.classList.toggle('hidden', !vis);
          if (vis) shown++;
        }
        // Hide date groups that ended up empty.
        document.querySelectorAll<HTMLElement>('.date-group').forEach((g) => {
          const any = Array.from(g.querySelectorAll<HTMLElement>('.row')).some(
            (r) => !r.classList.contains('hidden')
          );
          g.style.display = any ? '' : 'none';
        });
        visibleCount.textContent = `${shown} shown`;
        updateSelCount();
      }
      typeSel.addEventListener('change', applyFilter);
      assignedSel.addEventListener('change', applyFilter);

      // Selection + copy-selected.
      const selCount = document.getElementById('sel-count')!;
      function selectedIds(): string[] {
        return rows
          .filter((r) => !r.classList.contains('hidden'))
          .filter((r) => r.querySelector<HTMLInputElement>('.row-check')!.checked)
          .map((r) => r.dataset.id ?? '');
      }
      function updateSelCount() {
        selCount.textContent = `${selectedIds().length} selected`;
      }
      checks().forEach((c) => c.addEventListener('change', updateSelCount));

      document.getElementById('select-visible')!.addEventListener('click', () => {
        rows
          .filter((r) => !r.classList.contains('hidden'))
          .forEach((r) => {
            r.querySelector<HTMLInputElement>('.row-check')!.checked = true;
          });
        updateSelCount();
      });
      document.getElementById('clear-sel')!.addEventListener('click', () => {
        checks().forEach((c) => (c.checked = false));
        updateSelCount();
      });
      document.getElementById('copy-selected')!.addEventListener('click', async (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        const ids = selectedIds();
        if (ids.length === 0) {
          flash(btn, 'none selected');
          return;
        }
        // Newline-separated: pastes cleanly into a Claude Code prompt as a list.
        const ok = await copyText(ids.join('\n'));
        flash(btn, ok ? `copied ${ids.length} ✓` : 'failed');
      });

      applyFilter();

      // -- Transcribe / Fix-grammar -------------------------------------------
      // These call the local dev-only endpoints in src/dev/openrouter-plugin.mjs
      // (POST /api/transcribe, /api/fix-grammar). They only work under
      // `npm run dev`; the deployed static site has no server, by design.
      // Results are kept in localStorage per fragment id so a reload doesn't
      // lose a transcript.

      // Short model tail + cost, appended to a status line after an AI call.
      function callMeta(d: { model?: string; costInr?: number | null }): string {
        const model = d.model ? ` · ${d.model.split('/').pop()}` : '';
        return model + (typeof d.costInr === 'number' ? ` · ${fmtInr(d.costInr)}` : '');
      }

      function fmtInr(n: number): string {
        return `~₹${n.toFixed(n < 1 ? 3 : 2)}`;
      }
      // Model + cost for a per-box label, e.g. "gpt-4o-mini-transcribe · ~₹0.019".
      function costLabel(d: { model?: string; costInr?: number | null }): string {
        const model = d.model ? d.model.split('/').pop() : '';
        return `${model}${typeof d.costInr === 'number' ? ' · ' + fmtInr(d.costInr) : ''}`;
      }

      // Running OpenRouter spend for this browser session (survives reloads).
      const SESSION_COST_KEY = 'fn-inbox:sessionCost';
      function readSessionCost(): number {
        try {
          return parseFloat(sessionStorage.getItem(SESSION_COST_KEY) || '0') || 0;
        } catch {
          return 0;
        }
      }
      function renderSessionCost() {
        const el = document.getElementById('session-cost');
        const total = readSessionCost();
        if (el) el.textContent = total > 0 ? `· session ${fmtInr(total)}` : '';
      }
      function addSessionCost(costInr: number | null | undefined) {
        if (typeof costInr !== 'number') return;
        try {
          sessionStorage.setItem(SESSION_COST_KEY, String(readSessionCost() + costInr));
        } catch {}
        renderSessionCost();
      }
      renderSessionCost();

      async function postJson(url: string, payload: unknown): Promise<any> {
        const r = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        let data: any = {};
        try {
          data = await r.json();
        } catch {
          throw new Error(`server returned a non-JSON response (${r.status}) — is \`npm run dev\` running?`);
        }
        if (!r.ok) throw new Error(data.error || `request failed (${r.status})`);
        return data;
      }

      function initTools(panel: HTMLElement) {
        const id = panel.dataset.toolsId ?? '';
        const transcriptKey = `fn-inbox:transcript:${id}`;
        const fixedKey = `fn-inbox:fixed:${id}`;
        const status = panel.querySelector<HTMLElement>('.tool-status')!;

        // Box 1 (audio only): the raw transcript, read-only, copyable.
        const transcriptBox = panel.querySelector<HTMLElement>('.transcript-box');
        const transcriptText = panel.querySelector<HTMLTextAreaElement>('.transcript-text');
        const transcriptCost = panel.querySelector<HTMLElement>('.transcript-box .tbox-cost');
        // Box 2: the grammar-fixed output.
        const fixedBox = panel.querySelector<HTMLElement>('.fixed-box')!;
        const fixedText = panel.querySelector<HTMLTextAreaElement>('.fixed-text')!;
        const fixedCost = panel.querySelector<HTMLElement>('.fixed-box .tbox-cost')!;
        const costKeyT = `fn-inbox:costT:${id}`;
        const costKeyF = `fn-inbox:costF:${id}`;
        // Generated voice (TTS of the cleaned text).
        const voiceBox = panel.querySelector<HTMLElement>('.voice-box');
        const voicePlayer = panel.querySelector<HTMLElement>('.voice-player');
        const voiceCost = panel.querySelector<HTMLElement>('.voice-cost');
        const voiceKey = `fn-inbox:voice:${id}`;

        // Build a compact player for a generated narration URL and reveal it.
        function showVoice(url: string, costText?: string) {
          if (!voiceBox || !voicePlayer) return;
          voicePlayer.innerHTML =
            `<div class="aplayer" data-aplayer>` +
            `<button class="aplayer-play" type="button" aria-label="Play">` +
            `<svg class="ic-play" width="11" height="12" viewBox="0 0 11 12"><path d="M1 1 L10 6 L1 11 Z" fill="currentColor"/></svg>` +
            `<svg class="ic-pause" width="11" height="12" viewBox="0 0 11 12"><rect x="1" y="1" width="3" height="10" fill="currentColor"/><rect x="7" y="1" width="3" height="10" fill="currentColor"/></svg>` +
            `</button><div class="aplayer-track"><div class="aplayer-fill"></div></div>` +
            `<span class="aplayer-time mono">0:00</span>` +
            `<audio preload="metadata" src="${url}"></audio></div>`;
          initAudioPlayer(voicePlayer.firstElementChild as HTMLElement);
          if (voiceCost && costText !== undefined) voiceCost.textContent = costText;
          voiceBox.hidden = false;
        }

        // Persist a box's cost label so it survives reloads (the call already
        // happened — no double-counting into the session total on restore).
        function setBoxCost(el: HTMLElement | null, key: string, d: any) {
          const label = costLabel(d);
          if (el) el.textContent = label;
          try {
            localStorage.setItem(key, label);
          } catch {}
        }

        function setStatus(msg: string, isError = false) {
          status.textContent = msg;
          status.classList.toggle('error', isError);
          status.hidden = !msg;
        }
        function showTranscript(text: string) {
          if (!transcriptText || !transcriptBox) return;
          transcriptText.value = text;
          transcriptBox.hidden = false;
          try {
            localStorage.setItem(transcriptKey, text);
          } catch {}
        }
        function showFixed(text: string) {
          fixedText.value = text;
          fixedBox.hidden = false;
          try {
            localStorage.setItem(fixedKey, text);
          } catch {}
        }

        // Restore saved boxes across reloads.
        try {
          const t = localStorage.getItem(transcriptKey);
          if (t && transcriptText && transcriptBox) {
            transcriptText.value = t;
            transcriptBox.hidden = false;
          }
          const f = localStorage.getItem(fixedKey);
          if (f) {
            fixedText.value = f;
            fixedBox.hidden = false;
          }
          const ct = localStorage.getItem(costKeyT);
          if (ct && transcriptCost) transcriptCost.textContent = ct;
          const cf = localStorage.getItem(costKeyF);
          if (cf) fixedCost.textContent = cf;
          const vurl = localStorage.getItem(voiceKey);
          if (vurl) showVoice(vurl);
        } catch {}

        // Persist edits to the (editable) fixed box.
        fixedText.addEventListener('input', () => {
          try {
            localStorage.setItem(fixedKey, fixedText.value);
          } catch {}
        });

        function setBusy(busy: boolean) {
          panel
            .querySelectorAll<HTMLButtonElement>('.tool-btn')
            .forEach((b) => (b.disabled = busy));
        }

        panel.addEventListener('click', async (e) => {
          const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.tool-btn');
          if (!btn) return;
          const action = btn.dataset.action;

          if (action === 'copy-transcript') {
            const ok = await copyText(transcriptText?.value ?? '');
            flash(btn, ok ? 'copied ✓' : 'failed');
            return;
          }
          if (action === 'copy-fixed') {
            const ok = await copyText(fixedText.value);
            flash(btn, ok ? 'copied ✓' : 'failed');
            return;
          }
          if (action === 'save-transcript' || action === 'save-cleaned') {
            const kind = action === 'save-transcript' ? 'transcript' : 'cleaned';
            const value = kind === 'transcript' ? transcriptText?.value ?? '' : fixedText.value;
            if (!value.trim()) {
              flash(btn, 'nothing to save');
              return;
            }
            btn.disabled = true;
            try {
              const d = await postJson('/api/save-text', { id, kind, text: value });
              setStatus(`saved ${d.file}${d.pushed ? ' · pushed' : ''}`);
              flash(btn, 'saved ✓');
            } catch (err) {
              setStatus(String((err as Error).message || err), true);
            } finally {
              btn.disabled = false;
            }
            return;
          }
          if (action === 'generate-voice') {
            const text = fixedText.value.trim();
            if (!text) {
              flash(btn, 'nothing to voice');
              return;
            }
            btn.disabled = true;
            const label = btn.textContent;
            btn.textContent = 'generating…';
            setStatus('generating voice in your clone…');
            try {
              const d = await postJson('/api/generate-voice', { id, text });
              const meta = callMeta(d);
              showVoice(d.url, meta.replace(/^ · /, ''));
              addSessionCost(d.costInr);
              try {
                localStorage.setItem(voiceKey, d.url);
              } catch {}
              setStatus(`voice generated${meta}${d.pushed ? ' · pushed' : ''}`);
            } catch (err) {
              setStatus(String((err as Error).message || err), true);
            } finally {
              btn.disabled = false;
              btn.textContent = label;
            }
            return;
          }
          if (action === 'clear-fixed') {
            fixedText.value = '';
            fixedBox.hidden = true;
            fixedCost.textContent = '';
            if (voiceBox) voiceBox.hidden = true;
            if (voicePlayer) voicePlayer.innerHTML = '';
            setStatus('');
            try {
              localStorage.removeItem(fixedKey);
              localStorage.removeItem(costKeyF);
              localStorage.removeItem(voiceKey);
            } catch {}
            return;
          }

          setBusy(true);
          try {
            if (action === 'transcribe') {
              setStatus('transcribing audio…');
              const d = await postJson('/api/transcribe', { id });
              showTranscript(d.text);
              setBoxCost(transcriptCost, costKeyT, d);
              addSessionCost(d.costInr);
              setStatus(`transcribed${callMeta(d)} — read-only. Fix grammar or copy.`);
            } else if (action === 'fix') {
              // Source: the transcript (audio) or the fragment body (text).
              const source =
                btn.dataset.source === 'transcript'
                  ? transcriptText?.value ?? ''
                  : panel.querySelector<HTMLElement>('.src-text')?.textContent ?? '';
              if (!source.trim()) {
                setStatus('nothing to fix.', true);
                return;
              }
              setStatus('fixing grammar…');
              const d = await postJson('/api/fix-grammar', { text: source, prompt: getFixPrompt() });
              showFixed(d.text);
              setBoxCost(fixedCost, costKeyF, d);
              addSessionCost(d.costInr);
              setStatus(`cleaned up${callMeta(d)} — copy when ready.`);
            }
          } catch (err) {
            setStatus(String((err as Error).message || err), true);
          } finally {
            setBusy(false);
          }
        });
      }

      document.querySelectorAll<HTMLElement>('.tools').forEach(initTools);

      // Compact audio players (play/pause + progress + time).
      function initAudioPlayer(root: HTMLElement) {
        const audio = root.querySelector('audio') as HTMLAudioElement;
        const playBtn = root.querySelector('.aplayer-play') as HTMLButtonElement;
        const track = root.querySelector('.aplayer-track') as HTMLElement;
        const fillEl = root.querySelector('.aplayer-fill') as HTMLElement;
        const timeEl = root.querySelector('.aplayer-time') as HTMLElement;
        if (!audio || !playBtn) return;
        const fmt = (s: number) => {
          if (!isFinite(s) || s < 0) s = 0;
          return `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
        };
        playBtn.addEventListener('click', () => (audio.paused ? audio.play() : audio.pause()));
        audio.addEventListener('play', () => root.classList.add('playing'));
        audio.addEventListener('pause', () => root.classList.remove('playing'));
        audio.addEventListener('ended', () => root.classList.remove('playing'));
        audio.addEventListener('loadedmetadata', () => (timeEl.textContent = `0:00 / ${fmt(audio.duration)}`));
        audio.addEventListener('timeupdate', () => {
          const p = audio.duration ? audio.currentTime / audio.duration : 0;
          fillEl.style.width = `${p * 100}%`;
          timeEl.textContent = `${fmt(audio.currentTime)} / ${fmt(audio.duration)}`;
        });
        track.addEventListener('click', (e) => {
          const r = track.getBoundingClientRect();
          if (audio.duration) audio.currentTime = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width)) * audio.duration;
        });
      }
      document.querySelectorAll<HTMLElement>('[data-aplayer]').forEach(initAudioPlayer);

      // -- Delete a fragment (R2 object + local file + .md, commit + push) -----
      // Backed by POST /api/delete-fragment, which runs scripts/delete_fragment.py.
      // Irreversible, so it's gated behind typing the fragment id to confirm.
      function openDeleteConfirm(btn: HTMLButtonElement) {
        const id = btn.getAttribute('data-del-id') ?? '';
        const row = btn.closest<HTMLElement>('.row')!;
        const meta = row.querySelector<HTMLElement>('.meta')!;
        if (meta.querySelector('.del-confirm')) return; // already open
        btn.disabled = true;

        const box = document.createElement('div');
        box.className = 'del-confirm';
        box.innerHTML = `
          <p>Permanently delete <strong>${id}</strong> from Cloudflare R2 and GitHub? This cannot be undone.</p>
          <p>Type the id to confirm:</p>
          <input type="text" class="del-input" autocomplete="off" spellcheck="false" placeholder="${id}" />
          <div class="row-actions">
            <button type="button" class="tool-btn del-go" disabled>delete permanently</button>
            <button type="button" class="tool-btn subtle del-cancel">cancel</button>
            <span class="del-status" role="status"></span>
          </div>`;
        meta.appendChild(box);

        const input = box.querySelector<HTMLInputElement>('.del-input')!;
        const go = box.querySelector<HTMLButtonElement>('.del-go')!;
        const cancel = box.querySelector<HTMLButtonElement>('.del-cancel')!;
        const status = box.querySelector<HTMLElement>('.del-status')!;
        input.focus();

        input.addEventListener('input', () => {
          go.disabled = input.value.trim() !== id;
        });
        function close() {
          box.remove();
          btn.disabled = false;
        }
        cancel.addEventListener('click', close);
        go.addEventListener('click', async () => {
          go.disabled = true;
          cancel.disabled = true;
          status.textContent = 'deleting from R2 + GitHub…';
          try {
            await postJson('/api/delete-fragment', { id, confirm: input.value.trim() });
            const group = row.closest<HTMLElement>('.date-group');
            row.remove();
            if (group && !group.querySelector('.row')) group.style.display = 'none';
          } catch (err) {
            status.textContent = String((err as Error).message || err);
            cancel.disabled = false;
          }
        });
      }

      document.querySelectorAll<HTMLButtonElement>('[data-del-id]').forEach((btn) => {
        btn.addEventListener('click', () => openDeleteConfirm(btn));
      });

      // -- Pull latest fragments from GitHub ----------------------------------
      // The Telegram bot commits fragments to main on GitHub (via Actions), not
      // to this machine. This runs `git pull --ff-only` server-side; when it
      // brings in new commits the page reloads so they render.
      const pullBtn = document.getElementById('pull-btn') as HTMLButtonElement | null;
      if (pullBtn) {
        const pullStatus = document.getElementById('pull-status')!;
        pullBtn.addEventListener('click', async () => {
          pullBtn.disabled = true;
          pullStatus.textContent = 'pulling…';
          try {
            const r = await fetch('/api/pull', { method: 'POST' });
            const d = await r.json();
            if (!r.ok) throw new Error(d.error || `pull failed (${r.status})`);
            if (d.updated) {
              pullStatus.textContent = 'new fragments — reloading…';
              // Give Astro's content watcher a moment to re-sync the new files.
              setTimeout(() => location.reload(), 1000);
            } else {
              pullStatus.textContent = 'already up to date';
              pullBtn.disabled = false;
            }
          } catch (err) {
            pullStatus.textContent = String((err as Error).message || err);
            pullBtn.disabled = false;
          }
        });

        // "Fetch from Telegram": trigger the ingest Action, wait, then pull.
        const fetchBtn = document.getElementById('fetch-btn') as HTMLButtonElement | null;
        if (fetchBtn) {
          fetchBtn.addEventListener('click', async () => {
            fetchBtn.disabled = true;
            pullBtn.disabled = true;
            pullStatus.textContent = 'triggering Telegram ingest on GitHub… (~1–2 min)';
            try {
              const r = await fetch('/api/fetch-telegram', { method: 'POST' });
              const d = await r.json();
              if (!r.ok) throw new Error(d.error || `fetch failed (${r.status})`);
              if (d.updated) {
                pullStatus.textContent = 'new fragments — reloading…';
                setTimeout(() => location.reload(), 1000);
              } else {
                pullStatus.textContent = 'ingest ran — nothing new';
                fetchBtn.disabled = false;
                pullBtn.disabled = false;
              }
            } catch (err) {
              pullStatus.textContent = String((err as Error).message || err);
              fetchBtn.disabled = false;
              pullBtn.disabled = false;
            }
          });
        }
      }

      // -- Capture new fragments: record audio / upload / paste ----------------
      // Posts the media to /api/create-fragment (dev only), which writes it as a
      // fragment via scripts/create_fragment.py, then reloads to show it.
      const captureStatus = document.getElementById('capture-status')!;
      const noteInput = document.getElementById('note-input') as HTMLInputElement;

      function setCaptureStatus(msg: string, isError = false) {
        captureStatus.textContent = msg;
        captureStatus.classList.toggle('error', isError);
      }

      // Send one blob; returns the new fragment id (throws on failure).
      async function sendCapture(blob: Blob, type: 'photo' | 'audio' | 'video', ext: string): Promise<string> {
        const headers: Record<string, string> = {
          'Content-Type': 'application/octet-stream',
          'X-Fragment-Type': type,
          'X-Fragment-Ext': ext,
        };
        const note = noteInput.value.trim();
        if (note) headers['X-Fragment-Note'] = encodeURIComponent(note);
        const r = await fetch('/api/create-fragment', { method: 'POST', headers, body: blob });
        const d = await r.json();
        if (!r.ok) throw new Error(d.error || `save failed (${r.status})`);
        return d.id;
      }

      // Remember what was just created so the reloaded page can highlight it.
      function reloadHighlighting(ids: string[]) {
        try {
          sessionStorage.setItem('fn-inbox:justAdded', JSON.stringify(ids));
        } catch {}
        setTimeout(() => location.reload(), 700);
      }

      async function captureOne(blob: Blob, type: 'photo' | 'audio' | 'video', ext: string) {
        setCaptureStatus(`saving ${type}…`);
        try {
          const id = await sendCapture(blob, type, ext);
          setCaptureStatus(`saved ${id} — reloading…`);
          reloadHighlighting([id]);
        } catch (err) {
          setCaptureStatus(String((err as Error).message || err), true);
        }
      }

      // Record audio (MediaRecorder; localhost is a secure context so mic works).
      const recBtn = document.getElementById('rec-btn') as HTMLButtonElement;
      let mediaRecorder: MediaRecorder | null = null;
      let chunks: BlobPart[] = [];
      recBtn.addEventListener('click', async () => {
        if (mediaRecorder && mediaRecorder.state === 'recording') {
          mediaRecorder.stop();
          return;
        }
        try {
          const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
          mediaRecorder = new MediaRecorder(stream);
          chunks = [];
          mediaRecorder.ondataavailable = (e) => {
            if (e.data.size) chunks.push(e.data);
          };
          mediaRecorder.onstop = () => {
            stream.getTracks().forEach((t) => t.stop());
            recBtn.classList.remove('recording');
            recBtn.textContent = '● record audio';
            const mime = mediaRecorder?.mimeType || 'audio/webm';
            const ext = mime.includes('ogg') ? 'ogg' : mime.includes('mp4') ? 'm4a' : 'webm';
            const blob = new Blob(chunks, { type: mime });
            if (blob.size) captureOne(blob, 'audio', ext);
          };
          mediaRecorder.start();
          recBtn.classList.add('recording');
          recBtn.textContent = '■ stop recording';
          setCaptureStatus('recording… click stop when done');
        } catch {
          setCaptureStatus('microphone access denied or unavailable', true);
        }
      });

      // Upload photo(s)/video(s).
      const fileInput = document.getElementById('file-input') as HTMLInputElement;
      fileInput.addEventListener('change', async () => {
        const files = Array.from(fileInput.files || []);
        fileInput.value = '';
        try {
          const ids: string[] = [];
          for (const file of files) {
            const type =
              file.type.startsWith('video/') ? 'video' : file.type.startsWith('image/') ? 'photo' : null;
            if (!type) {
              setCaptureStatus(`skipped ${file.name}: not an image or video`, true);
              continue;
            }
            setCaptureStatus(`saving ${file.name}…`);
            const ext = (file.name.split('.').pop() || '').toLowerCase();
            ids.push(await sendCapture(file, type, ext));
          }
          if (ids.length) {
            setCaptureStatus(`saved ${ids.length} — reloading…`);
            reloadHighlighting(ids);
          }
        } catch (err) {
          setCaptureStatus(String((err as Error).message || err), true);
        }
      });

      // Paste a screenshot from the clipboard anywhere on the page.
      document.addEventListener('paste', (e: ClipboardEvent) => {
        const items = Array.from(e.clipboardData?.items || []);
        const img = items.find((it) => it.type.startsWith('image/'));
        if (!img) return; // let normal text paste (e.g. into the note field) proceed
        const file = img.getAsFile();
        if (!file) return;
        e.preventDefault();
        const ext = (img.type.split('/')[1] || 'png').toLowerCase();
        captureOne(file, 'photo', ext);
      });

      // Highlight fragments created in the previous capture (survives the reload
      // via sessionStorage; cleared after showing so it only flags once).
      try {
        const raw = sessionStorage.getItem('fn-inbox:justAdded');
        if (raw) {
          sessionStorage.removeItem('fn-inbox:justAdded');
          const justIds: string[] = JSON.parse(raw);
          let firstRow: HTMLElement | null = null;
          for (const id of justIds) {
            const row = document.querySelector<HTMLElement>(`.row[data-id="${id}"]`);
            if (!row) continue;
            row.classList.add('just-added');
            const idLine = row.querySelector('.id-line');
            if (idLine && !idLine.querySelector('.just-badge')) {
              const badge = document.createElement('span');
              badge.className = 'just-badge';
              badge.textContent = 'just added';
              idLine.appendChild(badge);
            }
            if (!firstRow) firstRow = row;
          }
          firstRow?.scrollIntoView({ block: 'center', behavior: 'smooth' });
        }
      } catch {}

      // -- Models & editable grammar prompt -----------------------------------
      const FIX_PROMPT_KEY = 'fn-inbox:fixPrompt';
      let defaultFixPrompt = '';
      const fixPromptEl = document.getElementById('fix-prompt') as HTMLTextAreaElement | null;

      // The prompt sent with a Fix-grammar call: the (possibly edited) textarea,
      // else empty so the server falls back to its default.
      function getFixPrompt(): string {
        if (fixPromptEl && fixPromptEl.value.trim()) return fixPromptEl.value;
        try {
          return localStorage.getItem(FIX_PROMPT_KEY) || '';
        } catch {
          return '';
        }
      }

      (async () => {
        try {
          const cfg = await (await fetch('/api/config')).json();
          const tm = document.getElementById('transcribe-model');
          if (tm) tm.textContent = cfg.transcribeModel;
          const fm = document.getElementById('fix-model');
          if (fm) fm.textContent = cfg.fixModel;
          defaultFixPrompt = cfg.fixPrompt || '';
          if (fixPromptEl) {
            let saved = '';
            try {
              saved = localStorage.getItem(FIX_PROMPT_KEY) || '';
            } catch {}
            fixPromptEl.value = saved || defaultFixPrompt;
            const savedNote = document.getElementById('prompt-saved');
            fixPromptEl.addEventListener('input', () => {
              try {
                localStorage.setItem(FIX_PROMPT_KEY, fixPromptEl.value);
              } catch {}
              if (savedNote) savedNote.textContent = 'saved in this browser';
            });
          }
        } catch {}
      })();

      document.getElementById('prompt-reset')?.addEventListener('click', () => {
        if (fixPromptEl) fixPromptEl.value = defaultFixPrompt;
        try {
          localStorage.removeItem(FIX_PROMPT_KEY);
        } catch {}
        const savedNote = document.getElementById('prompt-saved');
        if (savedNote) savedNote.textContent = 'reset to default';
      });
    </script>
  </body>
</html>
