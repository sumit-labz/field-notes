---
// /about — a dated, append-only stack. Newest full ink; the past recedes
// through graphite then ghost (never opacity — material, not a fade). The
// sized obsession mix per entry is the biography.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const entries = (await getCollection('about')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const identityEntries = await getCollection('identities');
const identityTitle = new Map(
  identityEntries.map((i) => [i.data.slug, i.data.title])
);

// Entry recede (newest = current, older fade to ghost) is genuinely by stack
// position — that's the timeline. The obsession mix is NOT: each label's size
// and colour comes from its own explicit weight, so four items resolve to four
// distinct weights regardless of order or count.
const layerClass = (index: number) =>
  index === 0 ? 'about-entry--current' : index === 1 ? 'about-entry--past' : 'about-entry--archive';

const MIX_WEIGHT: Record<'dominant' | 'present' | 'emerging' | 'quiet', { size: string; color: string }> = {
  dominant: { size: '1.6rem', color: 'var(--ink)' },
  present: { size: '1.25rem', color: 'var(--ink)' },
  emerging: { size: '1rem', color: 'var(--graphite)' },
  quiet: { size: '0.85rem', color: 'var(--ghost)' },
};
---

<Base title="About">
  <h1>About</h1>
  <p class="annotation">do I fit anywhere? no. that's the whole page.</p>

  <div class="about-stack">
    {
      entries.map((entry, i) => (
        <div class={`about-entry ${layerClass(i)}`}>
          <div class="date">{entry.data.season}</div>
          <div class="text">{entry.body ?? ''}</div>
          {entry.data.mix && entry.data.mix.length > 0 && (
            <div class="about-mix">
              {entry.data.mix.map((item) => (
                <span
                  style={`font-size:${MIX_WEIGHT[item.weight].size};color:${MIX_WEIGHT[item.weight].color}`}
                >
                  {identityTitle.get(item.slug) ?? item.slug}
                </span>
              ))}
            </div>
          )}
        </div>
      ))
    }
  </div>

  <p class="about-notebook">old versions never leave. you can watch a person change their mind.</p>
</Base>