---
// /about — the biography as layers you peel open, newest first. Each era is a
// collapsible card: period + title + a one-line hook always visible, the rest
// behind a click. The newest layer opens by default; the past stays folded and
// recedes ink → graphite → ghost. Keeps a long life short on the page while
// letting you "watch a person change their mind."
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';

type Era = {
  period: string;
  title: string;
  hook: string;
  body: string[];
  // Studio Zero's ingredients, rendered as an emphasised inline list.
  tags?: string[];
  // Paragraphs that come after the tag list (Studio Zero).
  body2?: string[];
  // Optional link to a fuller page (Studio Zero → its practice page).
  link?: { href: string; label: string };
  // A dry closing line in the margin voice.
  aside?: string;
};

const eras: Era[] = [
  {
    period: '2026 · NOW',
    title: 'Studio Zero',
    hook: 'The maker is back.',
    body: [
      "After years of software, design, art, cinema, writing, and music, I'm putting the pieces in the same room.",
      'Studio Zero is my attempt at a one-person creative studio. It started as an idea I had a long time ago, got quietly forgotten, and has now returned with considerably more baggage.',
      "I'm bringing together the things that have kept pulling at me:",
    ],
    tags: ['Design', 'Art', 'Cinema', 'Music', 'Story', 'Software'],
    body2: [
      'AI lets me build the things I always wanted to make — I direct the software instead of disappearing into its detail, and keep authorship over what comes out.',
      "Currently: making things, and letting them talk to each other.",
    ],
    link: { href: '/studio-zero/', label: 'inside the studio →' },
    aside: 'making is making a comeback.',
  },
  {
    period: '2019 · ∞',
    title: 'The Art Incident',
    hook: "Art became the thing I thought I'd do for the rest of my life.",
    body: [
      'It started with graphic design, which led me to illustration, and illustration led me to visual art. Studying art history and art movements caught me — another rabbit hole I fell straight into. I started learning to draw. Still at it. Not looking to finish.',
      "Around the same time, cinema got its hooks in. Watching David Fincher’s The Killer pulled me toward the monologue — a voice that sounds true despite everything the character does. I’m still trying to figure out how to build one.",
      'I made things. No body of work — another technique, another artist, another rabbit hole, always.',
    ],
    aside: 'body of work: pending. apparently studying art is also a very effective way of avoiding making art.',
  },
  {
    period: '2019',
    title: 'The Design Phase',
    hook: 'I left code for interfaces.',
    body: [
      'I left software development for UX design — Interaction Design Foundation, a UX case study, a mobile app prototype built.',
      'I was interested in how things work, but increasingly in how they feel. Interfaces. Typography. Visual language. Systems. Making things understandable.',
      'Chasing typography led me into graphic design, and graphic design into branding. I completed a full visual branding exercise.',
    ],
  },
  {
    period: '2004 — 2019',
    title: 'The Software Developer',
    hook: 'For fifteen years, I made software.',
    body: [
      'Mostly Microsoft technologies. Mobile apps for Android and iOS, microservices, Web APIs, cloud, products, systems. The usual machinery.',
      'Alongside the day job I kept trying to build SaaS products of my own. None of them finished. I read everything about startups and lean startups — half of it, anyway.',
      'I was always interested in UX, though, and kept looking beyond the code toward the experience of the thing being built.',
    ],
  },
];

const layerClass = (index: number) =>
  index === 0 ? 'era--current' : index === 1 ? 'era--past' : 'era--archive';
---

<Base title="About">
  <h1>About</h1>
  <p class="annotation">warning: a lot of unfinished work ahead — read at your own caution.</p>
  <p class="annotation">do I fit anywhere? no. that's the whole page.</p>

  <div class="about-eras">
    {
      eras.map((era, i) => (
        <details class={`era ${layerClass(i)}`} open={i === 0}>
          <summary class="era__head">
            <span class="era__period">
              {era.period.split('∞').map((part, k) => (
                <>
                  {k > 0 && <span class="era__infinity">∞</span>}
                  {part}
                </>
              ))}
            </span>
            <span class="era__title">{era.title}</span>
            <span class="era__hook">{era.hook}</span>
          </summary>
          <div class="era__body">
            {era.body.map((p) => (
              <p>{p}</p>
            ))}
            {era.tags && (
              <p class="era__tags">
                {era.tags.map((t, j) => (
                  <>
                    {j > 0 && <span class="era__tags-sep"> · </span>}
                    {t}
                  </>
                ))}
              </p>
            )}
            {era.body2 && era.body2.map((p) => <p>{p}</p>)}
            {era.link && (
              <p class="era__link">
                <a href={withBase(era.link.href)}>{era.link.label}</a>
              </p>
            )}
            {era.aside && <p class="about-notebook">{era.aside}</p>}
          </div>
        </details>
      ))
    }
  </div>

  <p class="about-notebook">old versions never leave. you can watch a person change their mind.</p>
</Base>
