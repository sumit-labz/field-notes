---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FragmentBlock from '../../components/Fragment.astro';
import { splitPostBody } from '../../lib/post-body';
import { withBase } from '../../lib/url';
import { dateLine } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const fragments = await getCollection('fragments');
const fragmentsById = new Map(fragments.map((f) => [f.data.id, f]));
const blocks = splitPostBody(post.body ?? '', post.data.fragments);

// Optional raw transcript from the repo-root transcripts/ dir, read at build
// via Vite's raw glob (posts/[slug].astro → four levels up is the repo root).
// The `transcript` field is a pointer; a missing file renders nothing.
const transcriptFiles = import.meta.glob<string>('../../../../transcripts/**/*', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const transcriptByName = new Map<string, string>();
for (const [filePath, content] of Object.entries(transcriptFiles)) {
  const name = filePath.split('/').pop();
  if (name) transcriptByName.set(name, content as string);
}
const transcriptText = post.data.transcript
  ? transcriptByName.get(post.data.transcript) ?? null
  : null;
---

<Base title={post.data.title}>
  <p><a href={withBase('/')}>← feed</a></p>
  <h1>
    {post.data.title}
    {post.data.status === 'in_progress' && <span class="inprogress">in progress</span>}
  </h1>
  <p class="meta">
    {dateLine(post.data.published)}
    {' · '}{post.data.fragments.length} fragments
    {post.data.kind === 'insight' && <> · note to self</>}
    {post.data.journey && (
      <>
        {' '}
        · <a href={withBase(`/journeys/${post.data.journey}/`)}>{post.data.journey}</a>
      </>
    )}
  </p>

  {
    blocks.map((block) =>
      block.kind === 'text' ? (
        <Fragment set:html={block.html} />
      ) : (
        (() => {
          const fragment = fragmentsById.get(block.id);
          return fragment ? <FragmentBlock fragment={fragment} /> : null;
        })()
      )
    )
  }

  {
    transcriptText && (
      <details class="transcript-raw">
        <summary>before cleanup</summary>
        <div class="transcript-raw-body">{transcriptText}</div>
      </details>
    )
  }
</Base>

<style>
  /* Raw transcript: the "before cleanup" record. Space Mono, lighter ink,
     line breaks preserved, no other styling; native <details>, no motion. */
  .transcript-raw {
    margin-top: 3rem;
  }
  .transcript-raw summary {
    font-family: 'Space Mono', monospace;
    font-size: 0.85rem;
    color: var(--graphite);
    cursor: pointer;
  }
  .transcript-raw-body {
    margin-top: 1rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.85rem;
    color: var(--graphite);
    white-space: pre-wrap;
  }
</style>
