---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FragmentBlock from '../../components/Fragment.astro';
import AuthorFooter from '../../components/AuthorFooter.astro';
import MadeWith from '../../components/MadeWith.astro';
import OriginGlyph from '../../components/OriginGlyph.astro';
import { authorLineFor } from '../../lib/authorLines';
import { splitPostBody } from '../../lib/post-body';
import { withBase } from '../../lib/url';
import { dateLine, gradedOrOriginal, postLeadMedia, postTeaser, stampDate } from '../../lib/content';
import { originFor } from '../../lib/post-origin';
import { mediaUrl } from '../../lib/media-url';
import { isLocalMedia, localMediaUrl } from '../../lib/local-media';
import { getImageDimensions, getLocalImageDimensions } from '../../lib/image-dimensions';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

// One of a small set of self-descriptions, picked deterministically by post
// slug — see lib/authorLines.ts. Varies post to post instead of repeating a
// single fixed tagline under every one.
const authorLine = authorLineFor(post.data.slug);

const fragments = await getCollection('fragments');
const journeyTitle = post.data.journey
  ? (await getCollection('journeys')).find((j) => j.data.slug === post.data.journey)?.data.title ?? post.data.journey
  : null;
const fragmentsById = new Map(fragments.map((f) => [f.data.id, f]));

// Reading time from the prose alone (fragment markers stripped), ~220 wpm.
const wordCount = (post.body ?? '').replace(/\{\{fragment:[^}]+\}\}/g, ' ').split(/\s+/).filter(Boolean).length;
const readMinutes = Math.max(1, Math.round(wordCount / 220));

// Neighbours along the same journey, oldest-first — drives the "next" card at
// the end of the read and swipe navigation on touch screens.
const journeyPosts = post.data.journey
  ? (await getCollection('posts'))
      .filter((p) => p.data.journey === post.data.journey)
      .sort((a, b) => a.data.published.valueOf() - b.data.published.valueOf())
  : [];
const posIdx = journeyPosts.findIndex((p) => p.data.slug === post.data.slug);
const prevPost = posIdx > 0 ? journeyPosts[posIdx - 1] : null;
const nextPost = posIdx >= 0 && posIdx < journeyPosts.length - 1 ? journeyPosts[posIdx + 1] : null;
const nextMedia = nextPost ? await postLeadMedia(nextPost, fragmentsById) : null;
const nextTeaser = nextPost ? postTeaser(nextPost, 120) : '';
const blocks = splitPostBody(post.body ?? '', post.data.fragments);

// Word timings for Stage mode (scripts/generate_word_timings.py), from the
// repo-root narration/ dir. Only offered when this post has both.
const timingFiles = import.meta.glob<unknown>('../../../../narration/*.json', {
  import: 'default',
  eager: true,
});
const stageTimings = post.data.audio
  ? Object.entries(timingFiles).find(([f]) => f.endsWith(`/${post.data.slug}.json`))?.[1] ?? null
  : null;

// Optional narration audio (R2 key, or a local media/ path).
const postAudioUrl = post.data.audio
  ? isLocalMedia(post.data.audio)
    ? localMediaUrl(post.data.audio)
    : mediaUrl(post.data.audio)
  : null;

const IMAGE_RE = /\.(webp|jpe?g|png|gif|avif)$/i;
function imageSrcFor(key: string): string | null {
  if (isLocalMedia(key)) return localMediaUrl(key);
  return mediaUrl(key);
}
// Local media (photos from the web inbox, not R2) is read off disk, not
// fetched — a build-emitted asset URL isn't fetchable during SSG.
function imageDimensionsFor(key: string, src: string): Promise<{ width: number; height: number }> {
  if (isLocalMedia(key)) return Promise.resolve(getLocalImageDimensions(key));
  return getImageDimensions(src);
}
// The first image key a fragment has, resolved through gradedOrOriginal() —
// a graded (e.g. grayscale) copy should win here exactly like it does in the
// Fragment component itself, not silently fall back to the untouched photo.
function firstImageKey(fragment: (typeof fragments)[number]): string | null {
  const media = fragment.data.media;
  if (!media) return null;
  const index = media.findIndex((k) => IMAGE_RE.test(k));
  if (index === -1) return null;
  return gradedOrOriginal(fragment, index);
}

// Opener: the first image of the first fragment (in listed order) that has
// one. That fragment is excluded from the sequence below so the image doesn't
// appear twice. No images → no opener.
// Full-bleed 70vh cover only suits properly landscape photos — cropping a
// tall portrait shot, or a square one, down to a short wide banner throws
// away most of the frame (see the field-notes typography post: a portrait
// ink photo lost everything but a thin cross-section; the StoryDojo
// notebook-photo cover had the same problem despite being square, not tall —
// a 1:1 frame squeezed into 70vh still loses its top and bottom). Portrait
// and square openers instead render at their own aspect ratio, capped in
// height, so the whole photo stays visible.
// An explicit `cover` fragment (see the posts schema) wins the opener slot;
// otherwise the first listed fragment that has an image does. Either way the
// chosen fragment is excluded from the sequence below so it isn't shown twice.
let openerSrc: string | null = null;
let openerFragmentId: string | null = null;
let openerPortrait = false;
const openerOrder = post.data.cover
  ? [post.data.cover, ...post.data.fragments.filter((id) => id !== post.data.cover)]
  : post.data.fragments;
for (const id of openerOrder) {
  const f = fragmentsById.get(id);
  const imgKey = f ? firstImageKey(f) : null;
  if (imgKey) {
    openerSrc = imageSrcFor(imgKey);
    openerFragmentId = id;
    if (openerSrc) {
      try {
        const dims = await imageDimensionsFor(imgKey, openerSrc);
        openerPortrait = dims.height >= dims.width;
      } catch {
        /* dimensions unavailable — fall back to the landscape treatment */
      }
    }
    break;
  }
}

// Derived visual rhythm for the fragment sequence — all from existing data.
// Spacing comes from the gap to the PREVIOUS fragment's captured_at; width from
// spark; break direction from a running non-spark index. Rotation lives in
// lib/rotation.ts. Text blocks pass through untouched.
type Rendered =
  | { kind: 'text'; html: string }
  | {
      kind: 'fragment';
      fragment: (typeof fragments)[number];
      gapClass: string;
      gapLabel: string | null;
      widthClass: string;
      breakClass: string;
    };

function humanGap(mins: number): string {
  const days = Math.round(mins / 1440);
  return days <= 1 ? 'next day' : `${days} days later`;
}

const rendered: Rendered[] = [];
let prevCaptured: Date | null = null;
let nonSparkIdx = 0;
for (const block of blocks) {
  if (block.kind === 'text') {
    rendered.push({ kind: 'text', html: block.html });
    continue;
  }
  if (block.id === openerFragmentId) continue; // opener already shown up top
  const fragment = fragmentsById.get(block.id);
  if (!fragment) continue;
  const spark = fragment.data.spark;

  let gapClass = 'gap-none';
  let gapLabel: string | null = null;
  if (prevCaptured) {
    const mins = Math.abs(fragment.data.captured_at.getTime() - prevCaptured.getTime()) / 60000;
    if (mins < 15) gapClass = 'gap-tight';
    else if (mins < 180) gapClass = 'gap-normal';
    else if (mins < 1440) gapClass = 'gap-large';
    else {
      gapClass = 'gap-xlarge';
      gapLabel = humanGap(mins);
    }
  }
  prevCaptured = fragment.data.captured_at;

  // The 60%-width narrow treatment (with left/right stagger) suits portrait
  // photos — a landscape photo squeezed to 60% and shoved to one edge crops
  // its readability for no reason (see the typography-layout photo: a
  // landscape checklist that got narrowed and right-aligned). Landscape
  // fragment photos render full width regardless of spark/stagger.
  let landscape = false;
  const imgKey = firstImageKey(fragment);
  if (imgKey) {
    try {
      const dims = await imageDimensionsFor(imgKey, imageSrcFor(imgKey) ?? '');
      landscape = dims.width > dims.height;
    } catch {
      /* dimensions unavailable — fall back to the spark-driven width */
    }
  }

  const isMarkdownDoc = fragment.data.type === 'markdown';

  // A fragment with no photo, no caption text, and no markdown body renders
  // as a bare "{date} IST · {type}" stub (see Fragment.astro) — nothing
  // readers can actually see. That's the normal shape of an audio fragment
  // whose content already got folded into the post's prose by hand; skip it
  // instead of showing a dangling timestamp line.
  const hasCaption = (fragment.body ?? '').trim().length > 0;
  if (!imgKey && !hasCaption && !isMarkdownDoc) continue;

  const widthClass = spark || landscape || isMarkdownDoc ? 'w-full' : 'w-narrow';
  let breakClass = '';
  if (widthClass === 'w-narrow') {
    nonSparkIdx += 1;
    if (nonSparkIdx % 3 === 0) breakClass = 'break-right';
  }
  rendered.push({ kind: 'fragment', fragment, gapClass, gapLabel, widthClass, breakClass });
}
---

<Base title={post.data.title} progress reading>
  <div
    data-journey-nav
    data-prev={prevPost ? withBase(`/posts/${prevPost.data.slug}/`) : ''}
    data-next={nextPost ? withBase(`/posts/${nextPost.data.slug}/`) : ''}
    hidden
  />
  <header class:list={['post-hero', { 'post-hero--image': openerSrc }]}>
    {
      openerSrc && (
        <img
          class={`opener ${openerPortrait ? 'opener--portrait' : 'opener--landscape'}`}
          src={openerSrc}
          alt=""
          fetchpriority="high"
        />
      )
    }
    <div class="post-hero__text">
      <p class="post-kicker">
        <span>{journeyTitle ? `${journeyTitle}` : 'loose sheet'}</span>
        {posIdx >= 0 && <span>item {String(posIdx + 1).padStart(2, '0')} / {String(journeyPosts.length).padStart(2, '0')}</span>}
        <span>{stampDate(post.data.published)}</span>
        <span class={`post-kicker__origin post-kicker__origin--${originFor(post.data)}`}>
          <OriginGlyph origin={originFor(post.data)} size={12} />
          {originFor(post.data) === 'voice' ? 'voice note' : 'written'}
        </span>
      </p>
      <h1>
        {post.data.title}
        {post.data.status === 'in_progress' && <span class="inprogress">in progress</span>}
      </h1>
    </div>
  </header>
  <p class="meta">
    {dateLine(post.data.published)}{' · '}{readMinutes} min read
    {post.data.kind === 'insight' && <> · note to self</>}
    {post.data.journey && (
      <>
        {' '}
        · <a href={withBase(`/journeys/${post.data.journey}/`)}>{journeyTitle}</a>
      </>
    )}
  </p>

  {
    postAudioUrl && (
      <div class="listen" data-listen>
        <button class="listen-play" type="button" aria-label="Play">
          <svg class="ic-play" width="14" height="16" viewBox="0 0 14 16" aria-hidden="true">
            <path d="M1 1 L13 8 L1 15 Z" fill="currentColor" />
          </svg>
          <svg class="ic-pause" width="14" height="16" viewBox="0 0 14 16" aria-hidden="true">
            <rect x="1" y="1" width="4" height="14" fill="currentColor" />
            <rect x="9" y="1" width="4" height="14" fill="currentColor" />
          </svg>
        </button>
        <div class="listen-body">
          <div class="listen-head">
            <span class="listen-label">Listen</span>
            <span class="listen-viz" aria-hidden="true"><i /><i /><i /><i /><i /><i /><i /></span>
            <span class="listen-time mono">0:00</span>
            <button class="listen-rate" type="button" title="Playback speed">0.8×</button>
          </div>
          <div class="listen-track" role="slider" tabindex="0" aria-label="Seek" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <div class="listen-fill" />
          </div>
          <span class="listen-note" title="Read by an AI voice — the words are mine">a borrowed voice reads this<span class="sr-only"> (AI-generated narration)</span></span>
        </div>
        <audio preload="metadata" src={postAudioUrl} />
      </div>
    )
  }

  {
    rendered.map((item) =>
      item.kind === 'text' ? (
        <Fragment set:html={item.html} />
      ) : (
        <div class={`frag ${item.widthClass} ${item.breakClass} ${item.gapClass}`}>
          {item.gapLabel && <div class="gap-label">{item.gapLabel}</div>}
          <FragmentBlock fragment={item.fragment} />
        </div>
      )
    )
  }

  {authorLine && <AuthorFooter line={authorLine} />}

  {post.data.made_with && <MadeWith stage={post.data.made_with} />}

  {
    nextPost && (
      <a class="next-post" href={withBase(`/posts/${nextPost.data.slug}/`)}>
        <span class="next-post__kicker">Next in {journeyTitle} · {posIdx + 2} of {journeyPosts.length}</span>
        {nextMedia?.kind === 'image' && <img class="next-post__img" src={nextMedia.src} alt="" loading="lazy" />}
        <span class="next-post__title">{nextPost.data.title} →</span>
        {nextTeaser && <span class="next-post__teaser">{nextTeaser}</span>}
      </a>
    )
  }

  <p class="post-return">
    <a href={withBase('/')}>← back to feed</a>
  </p>

  {stageTimings && (
    <script type="application/json" id="stage-data" set:html={JSON.stringify({ title: post.data.title, ...(stageTimings as object) })} />
  )}

  <div class="read-pill" data-read-pill role="toolbar" aria-label="Reading tools">
    {postAudioUrl && (
      <button type="button" class="read-pill__btn" data-pill-listen aria-label="Listen">
        <svg class="ic-play" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12-7.5z" fill="currentColor"/></svg>
        <svg class="ic-pause" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4h3.5v16H7zM13.5 4H17v16h-3.5z" fill="currentColor"/></svg>
        <span class="read-pill__label" data-pill-listen-label>Listen</span>
        <span class="read-pill__gauge" data-pill-gauge aria-hidden="true"></span>
      </button>
    )}
    {postAudioUrl && (
      <button type="button" class="read-pill__btn read-pill__rate" data-pill-rate aria-label="Playback speed">0.8×</button>
    )}
    {postAudioUrl && <span class="read-pill__progress" data-pill-progress aria-hidden="true"><i /></span>}
    {stageTimings && (
      <button type="button" class="read-pill__btn read-pill__stage" data-stage-open aria-label="Watch on stage" title="the lights are on — watch it on stage">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5.5 13h13z" fill="currentColor" opacity=".35"/><ellipse cx="12" cy="17.5" rx="7" ry="2.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="3" r="1.6" fill="currentColor"/></svg>
      </button>
    )}
    <button type="button" class="read-pill__btn read-pill__size" data-pill-size aria-label="Text size">
      <span aria-hidden="true">A<small>A</small></span>
    </button>
    <button type="button" class="read-pill__btn" data-pill-share aria-label="Share">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="2.6" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="6" cy="12" r="2.6" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="18" cy="19" r="2.6" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8.3 10.8l7.4-4.3M8.3 13.2l7.4 4.3" stroke="currentColor" stroke-width="1.8"/></svg>
      <span class="read-pill__label" data-pill-share-label>Share</span>
    </button>
    <button type="button" class="read-pill__btn" data-theme-toggle aria-label="Switch theme">
      <svg class="ic-moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
      <svg class="ic-sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
    <span class="read-pill__left" data-pill-left aria-live="off" data-words={wordCount}></span>
    <button type="button" class="read-pill__btn" data-pill-top aria-label="Back to top">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5.5 11.5L12 5l6.5 6.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
</Base>

<script>
  import '../../client/read-pill';
  import '../../client/reading';
  import '../../client/stage';
</script>

<style>
  /* A clear way back to the feed at the end of the read, mirroring the top
     link (the wordmark is the only other route home now that nav has no feed
     item). */
  .post-return {
    margin-top: 4rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .post-return a {
    font-family: 'Archivo', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
  }

  /* Hero: a short cover with the title laid over its lower edge, so the
     first lines of the post are on screen the moment it opens (a full-height
     photo + title + player used to push the text below the fold). The whole
     cover is kept for the reader further down only when it's portrait —
     here it's a crop, framed toward the upper-middle where subjects sit. */
  .post-hero { margin: 0.5rem 0 0; }
  .post-hero--image {
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-top: 0;
    max-height: 44svh;
    min-height: 15rem;
    height: 44svh;
    overflow: hidden;
    background: var(--paper);
  }
  .post-hero--image .opener {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    object-fit: cover;
    object-position: 50% 35%;
  }
  .opener--portrait { object-position: 50% 30%; }
  /* the title sits on a fade into the page's own ground, so it reads on any
     photo and the image melts into the text below instead of ending hard */
  .post-hero--image::after {
    content: '';
    position: absolute;
    inset: 35% 0 0;
    background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--ground) 70%, transparent) 55%, var(--ground));
    pointer-events: none;
  }
  .post-hero--image h1 { margin: 0; }
  .post-hero--image .post-hero__text {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: 0.4rem;
    translate: -50% 0;
    width: min(43.75rem, 100%);
    margin: 0;
    padding: 0 1.5rem;
    text-wrap: balance;
    text-shadow: 0 1px 12px color-mix(in srgb, var(--ground) 80%, transparent);
  }
  @media (max-width: 720px) {
    .post-hero--image { height: 40svh; min-height: 13rem; }
    .post-hero--image .post-hero__text { padding: 0 1.25rem; }
  }
  @media (min-width: 721px) {
    .post-hero--image { height: min(52vh, 520px); max-height: none; }
  }
  .post-hero + .meta { margin-top: 0.5rem; margin-bottom: 1.4rem; }

  /* The narration player lives in the floating reading pill now (see
     client/read-pill.ts); this block stays in the DOM as the engine —
     one <audio>, rate, visualiser — but takes no room above the text. */
  .listen {
    position: absolute !important;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  /* Derived rhythm for the fragment sequence. Static only — spacing, width and
     break direction all come from data (spark, time gaps, index). */
  .frag { margin-top: 3rem; }
  .frag :global(figure) { margin: 0; }
  .frag.gap-none { margin-top: 1.5rem; }
  .frag.gap-tight { margin-top: 1rem; }
  .frag.gap-normal { margin-top: 3rem; }
  .frag.gap-large { margin-top: 8rem; }
  .frag.gap-xlarge { margin-top: 14rem; }
  /* w-full breaks out past the text column — a Medium-style "grande" image,
     wider than the prose but short of the full-bleed opener treatment. The
     min() keeps it fluid on mobile: it just settles back to column width
     once 94vw is narrower than 920px. */
  .frag.w-full {
    width: min(920px, 94vw);
    margin-left: 50%;
    transform: translateX(-50%);
  }
  .frag.w-narrow { width: 60%; margin-right: auto; }
  .frag.w-narrow.break-right { margin-left: auto; margin-right: 0; }
  .gap-label {
    font-family: 'Space Mono', monospace;
    font-size: 0.8rem;
    color: var(--ghost);
    margin-bottom: 1rem;
  }

  /* "Listen" narration player at the top of a post. Custom controls; the only
     motion is data-driven (progress from real playback, the visualiser from the
     audio's own frequency data) — no decorative CSS transitions, per the site's
     no-motion rule. */
  .listen {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin: 1.5rem 0 2rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .listen audio { display: none; }
  .listen-play {
    flex: none;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    padding: 0;
    color: var(--paper);
    background: var(--ink);
    border: none;
    border-radius: 50%;
    cursor: pointer;
  }
  .listen-play .ic-play { margin-left: 2px; }
  .listen-play .ic-pause { display: none; }
  .listen.playing .listen-play .ic-play { display: none; }
  .listen.playing .listen-play .ic-pause { display: block; }
  .listen-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .listen-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .listen-label {
    font-family: 'Archivo', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.8rem;
    color: var(--graphite);
  }
  /* A margin note in the handwriting voice rather than a system label —
     the title/sr-only text still says plainly that the voice is AI. */
  .listen-note {
    font-family: var(--font-annotation);
    font-size: 1.05rem;
    line-height: 1.1;
    color: var(--graphite);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* Visualiser: bar heights are set per frame from the audio's real frequency
     data while playing; at rest they sit flat. */
  .listen-viz {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 14px;
  }
  .listen-viz i {
    display: block;
    width: 2px;
    height: 15%;
    background: var(--graphite);
  }
  .listen-track {
    height: 4px;
    background: var(--line);
    cursor: pointer;
    position: relative;
  }
  .listen-fill {
    height: 100%;
    width: 0%;
    background: var(--ink);
  }
  .listen-rate {
    flex: none;
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
    color: var(--graphite);
    background: none;
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 2px 7px;
    cursor: pointer;
  }
  .listen-time {
    flex: none;
    margin-left: auto;
    font-size: 0.72rem;
    color: var(--graphite);
    white-space: nowrap;
  }

</style>

<script>
  // Custom "Listen" player: play/pause, data-driven progress, seek, rate toggle
  // (default 0.8×), and a visualiser driven by the audio's own frequency data.
  // No decorative motion — everything moves only in response to real playback.
  function setupListen(root: HTMLElement) {
    const audio = root.querySelector('audio') as HTMLAudioElement;
    const playBtn = root.querySelector('.listen-play') as HTMLButtonElement;
    const track = root.querySelector('.listen-track') as HTMLElement;
    const fill = root.querySelector('.listen-fill') as HTMLElement;
    const timeEl = root.querySelector('.listen-time') as HTMLElement;
    const rateBtn = root.querySelector('.listen-rate') as HTMLButtonElement;
    const bars = Array.from(root.querySelectorAll('.listen-viz i')) as HTMLElement[];
    if (!audio || !playBtn) return;

    const RATES = [0.8, 1, 1.25, 1.5];
    let rateIdx = 0;
    audio.playbackRate = RATES[0];
    rateBtn.textContent = '0.8×';

    const fmt = (s: number) => {
      if (!isFinite(s) || s < 0) s = 0;
      const m = Math.floor(s / 60);
      const sec = Math.floor(s % 60);
      return `${m}:${String(sec).padStart(2, '0')}`;
    };
    const restViz = () => bars.forEach((b) => (b.style.height = '15%'));

    playBtn.addEventListener('click', () => {
      if (audio.paused) {
        ensureGraph(); // build the Web Audio graph inside the real user gesture
        audio.play();
      } else {
        audio.pause();
      }
    });
    audio.addEventListener('play', () => {
      root.classList.add('playing');
      playBtn.setAttribute('aria-label', 'Pause');
      startViz();
    });
    const onStop = () => {
      root.classList.remove('playing');
      playBtn.setAttribute('aria-label', 'Play');
    };
    audio.addEventListener('pause', onStop);
    audio.addEventListener('ended', onStop);

    audio.addEventListener('loadedmetadata', () => {
      timeEl.textContent = `0:00 / ${fmt(audio.duration)}`;
    });
    audio.addEventListener('timeupdate', () => {
      const p = audio.duration ? audio.currentTime / audio.duration : 0;
      fill.style.width = `${p * 100}%`;
      track.setAttribute('aria-valuenow', String(Math.round(p * 100)));
      timeEl.textContent = `${fmt(audio.currentTime)} / ${fmt(audio.duration)}`;
    });

    const seek = (clientX: number) => {
      const r = track.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (clientX - r.left) / r.width));
      if (audio.duration) audio.currentTime = p * audio.duration;
    };
    track.addEventListener('click', (e) => seek(e.clientX));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') audio.currentTime = Math.min(audio.duration || 0, audio.currentTime + 5);
      if (e.key === 'ArrowLeft') audio.currentTime = Math.max(0, audio.currentTime - 5);
    });

    rateBtn.addEventListener('click', () => {
      rateIdx = (rateIdx + 1) % RATES.length;
      audio.playbackRate = RATES[rateIdx];
      rateBtn.textContent = `${RATES[rateIdx]}×`;
    });

    // Visualiser from the audio's real frequency data. Built ONLY inside the
    // user gesture, and only routed through Web Audio if the graph sets up — so
    // if any of this fails, the plain <audio> element still plays normally.
    let analyser: AnalyserNode | null = null;
    let data: Uint8Array<ArrayBuffer> | null = null;
    let ac: AudioContext | null = null;
    let graphTried = false;
    let raf = 0;
    function ensureGraph() {
      if (graphTried) return;
      graphTried = true;
      // Cross-origin audio (R2) without CORS headers is silenced by Web Audio:
      // the element "plays" but outputs zeros. Only route same-origin audio
      // through the graph; remote narration gets the idle visualiser instead.
      if (new URL(audio.currentSrc || audio.src, location.href).origin !== location.origin) return;
      try {
        const Ctx = window.AudioContext || (window as any).webkitAudioContext;
        if (!Ctx) return;
        ac = new Ctx();
        ac.resume();
        const srcNode = ac.createMediaElementSource(audio);
        analyser = ac.createAnalyser();
        analyser.fftSize = 64;
        srcNode.connect(analyser);
        analyser.connect(ac.destination);
        data = new Uint8Array(new ArrayBuffer(analyser.frequencyBinCount));
      } catch {
        analyser = null; // audio element keeps playing on its own
      }
    }
    // No frequency data (remote audio): a gentle, seeded breathing pattern
    // so the bars still say "speaking" without pretending to be the signal.
    function idleViz() {
      const loop = (t: number) => {
        if (audio.paused) { raf = 0; restViz(); return; }
        bars.forEach((b, i) => {
          const v = (Math.sin(t / 260 + i * 1.7) + Math.sin(t / 410 + i * 0.9)) / 4 + 0.5;
          b.style.height = `${20 + v * 60}%`;
        });
        raf = requestAnimationFrame(loop);
      };
      raf = requestAnimationFrame(loop);
    }
    function startViz() {
      if (raf) return;
      if (!analyser || !data) { idleViz(); return; }
      try {
        if (ac && ac.state === 'suspended') ac.resume();
        const n = bars.length;
        const loop = () => {
          if (audio.paused || !analyser || !data) {
            raf = 0;
            restViz();
            return;
          }
          analyser.getByteFrequencyData(data);
          for (let i = 0; i < n; i++) {
            const v = data[Math.floor(((i + 1) * data.length) / (n + 1))] / 255;
            bars[i].style.height = `${15 + v * 85}%`;
          }
          raf = requestAnimationFrame(loop);
        };
        raf = requestAnimationFrame(loop);
      } catch {
        /* Web Audio unavailable — playback still works, just no visualiser. */
      }
    }

    restViz();
  }

  document.querySelectorAll<HTMLElement>('[data-listen]').forEach(setupListen);
</script>
