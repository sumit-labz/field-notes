---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import JourneyTitle from '../../components/JourneyTitle.astro';
import { paragraphs } from '../../lib/post-body';

export async function getStaticPaths() {
  const identities = await getCollection('identities');
  return identities.map((identity) => ({
    params: { slug: identity.data.slug },
    props: { identity },
  }));
}

const { identity } = Astro.props;
const journeys = await getCollection('journeys');
const ownJourneys = journeys.filter((j) => j.data.identity === identity.data.slug);

const STATUS_ORDER = ['active', 'paused', 'abandoned', 'completed'] as const;
const groups = STATUS_ORDER.map((status) => ({
  status,
  journeys: ownJourneys.filter((j) => j.data.status === status),
})).filter((group) => group.journeys.length > 0);
---

<Base title={identity.data.title}>
  <p><a href="/identities">← identities</a></p>
  <h1>{identity.data.title}</h1>
  <Fragment set:html={paragraphs(identity.body ?? '')} />

  {
    groups.map((group) => (
      <section>
        {/* a status word, not a document heading — stays exempt from sentence case */}
        <p class="label">{group.status}</p>
        <ul>
          {group.journeys.map((journey) => (
            <li>
              <a href={`/journeys/${journey.data.slug}/`}>
                <JourneyTitle
                  title={journey.data.title}
                  status={journey.data.status}
                  seed={journey.data.slug}
                />
              </a>
              <p class="meta">started {journey.data.started.toISOString().slice(0, 10)}</p>
              {journey.data.status === 'abandoned' && journey.data.reason && (
                <p class="annotation">{journey.data.reason}</p>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
