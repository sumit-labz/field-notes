---
// /identities — the obsessions (label "Obsessions" in the UI; schema/route
// name stays `identity`), then Studio Zero: the independent practice that
// draws on all of them.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/url';

const identities = (await getCollection('identities')).sort((a, b) => a.data.order - b.data.order);
const journeys = await getCollection('journeys');
const journeysFor = (slug: string) =>
  journeys
    .filter((j) => j.data.identity === slug)
    .map((j) => j.data.title)
    .join(', ');
---

<Base title="Obsessions">
  <h1>Obsessions</h1>
  <p class="meta">what am I making pictures out of, and where's it going</p>
  <ul class="obsession-list">
    {
      identities.map((identity) => {
        const journey = journeysFor(identity.data.slug);
        return (
          <li>
            <a href={withBase(`/identities/${identity.data.slug}/`)}>{identity.data.title}</a>
            {journey && <span class="journey-of"> · {journey}</span>}
          </li>
        );
      })
    }
  </ul>

  <section class="studio-zero">
    <p class="label">practice</p>
    <h2>Studio Zero</h2>
    <p class="sz-desc">building an independent creative practice</p>
    <p class="sz-draws">draws on every obsession</p>
    <ul class="sz-inputs">
      {
        identities.map((identity) => (
          <li>
            <a href={withBase(`/identities/${identity.data.slug}/`)}>{identity.data.title}</a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
