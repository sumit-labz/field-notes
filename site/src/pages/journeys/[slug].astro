---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import JourneyTitle from '../../components/JourneyTitle.astro';
import ModeGlyph from '../../components/ModeGlyph.astro';
import PostThumb from '../../components/PostThumb.astro';
import { paragraphs } from '../../lib/post-body';
import { withBase } from '../../lib/url';
import { postLeadMedia, postTeaser, stampDate } from '../../lib/content';
import { originFor } from '../../lib/post-origin';

export async function getStaticPaths() {
  const journeys = await getCollection('journeys');
  return journeys.map((journey) => ({
    params: { slug: journey.data.slug },
    props: { journey },
  }));
}

const { journey } = Astro.props;
const { data } = journey;

const identities = await getCollection('identities');
const identity = identities.find((i) => i.data.slug === data.identity);
// Studio Zero owns journeys too, but it lives at its own route rather than in
// the identities collection — so link there when a journey belongs to it.
const owner =
  data.identity === 'studio-zero'
    ? { href: '/studio-zero/', title: 'Studio Zero' }
    : identity
      ? { href: `/identities/${identity.data.slug}/`, title: identity.data.title }
      : null;

const allJourneys = await getCollection('journeys');
// SPEC.md 3.3: emerged_from is the only relationship field; genealogy is derived
// from it rather than a separate graph structure.
const emergedFrom = data.emerged_from
  ? allJourneys.find((j) => j.data.slug === data.emerged_from)
  : null;
const becameJourneys = allJourneys.filter((j) => j.data.emerged_from === data.slug);

const allPosts = await getCollection('posts');
const posts = allPosts
  .filter((p) => p.data.journey === data.slug)
  .sort((a, b) => a.data.published.valueOf() - b.data.published.valueOf());

const STATUS_STAMP: Record<string, string> = {
  active: 'in progress',
  paused: 'on hold',
  abandoned: 'abandoned',
  completed: 'finished',
};

const fragments = await getCollection('fragments');
const fragmentsById = new Map(fragments.map((f) => [f.data.id, f]));
const postCards = await Promise.all(
  posts.map(async (post) => ({
    post,
    media: await postLeadMedia(post, fragmentsById),
    teaser: postTeaser(post),
  }))
);
---

<Base title={data.title} wide>
  <article class="box">
    <header class="box__head">
      <p class="plate__kicker">
        <a href={withBase('/')}>← studio</a>
        {owner && <a href={withBase(owner.href)}>{owner.title}</a>}
        <span>{data.path}</span>
        <span>box {data.slug}</span>
      </p>
      <h1 class="box__title">
        <JourneyTitle title={data.title} status={data.status} seed={data.slug} was={data.was} />
      </h1>
      <p class="box__meta">
        <ModeGlyph path={data.path} size={16} color="var(--graphite)" />
        begun {stampDate(data.started)}
        {data.ended && <> · ended {stampDate(data.ended)}</>}
        · {posts.length} {posts.length === 1 ? 'item' : 'items'} inside
      </p>
      <span class={`stamp-mark stamp-mark--${data.status}`}>{STATUS_STAMP[data.status]}</span>
    </header>

    <div class="box__note">
      {
        emergedFrom && (
          <p class="box__lineage">
            emerged from <a href={withBase(`/journeys/${emergedFrom.data.slug}/`)}>{emergedFrom.data.title}</a>
          </p>
        )
      }
      {
        data.was && (
          <p class="box__lineage box__turn">
            began as <s>{data.was}</s> · torn up and relabelled <b>{data.title}</b>
          </p>
        )
      }
      {data.status === 'abandoned' && data.reason && <p class="annotation">{data.reason}</p>}
      {
        becameJourneys.map((child) => (
          <p class="box__lineage">
            ↳ became: <a href={withBase(`/journeys/${child.data.slug}/`)}>{child.data.title}</a>
          </p>
        ))
      }
      <div class="box__text">
        <Fragment set:html={paragraphs(journey.body ?? '')} />
      </div>
    </div>

    <h2 class="box__contents">Contents <span>{String(posts.length).padStart(2, '0')}</span></h2>
    {
      postCards.length > 0 && (
        <div class="box__items">
          {postCards.map(({ post, media, teaser }, index) => (
            <div class="box__item">
              <PostThumb
                slug={post.data.slug}
                title={post.data.title}
                step={index + 1}
                teaser={teaser}
                media={media}
                inProgress={post.data.status === 'in_progress'}
                origin={originFor(post.data)}
                date={stampDate(post.data.published)}
              />
            </div>
          ))}
        </div>
      )
    }
  </article>
</Base>
