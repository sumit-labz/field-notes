---
// / — terms → hero journeys (learn/create only, last activity) → feed.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import JourneyCard from '../components/JourneyCard.astro';
import { withBase } from '../lib/url';
import {
  journeyLastActivity,
  journeyLeadLine,
  journeyLeadImage,
  postLeadImage,
  dateLine,
} from '../lib/content';
import { tiltForId } from '../lib/rotation';

const identityEntries = await getCollection('identities');
const identityTitle = new Map(
  identityEntries.map((i) => [i.data.slug, i.data.title])
);

const journeys = await getCollection('journeys');
const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);
const fragments = await getCollection('fragments');
const fragmentsById = new Map(fragments.map((f) => [f.data.id, f]));

// Hero: learn/create paths only (practice excluded — it'd top the feed daily),
// ordered by most recent activity. Abandoned journeys lead honestly.
const hero = journeys
  .filter((j) => j.data.path !== 'practice')
  .sort(
    (a, b) =>
      journeyLastActivity(b, posts).valueOf() - journeyLastActivity(a, posts).valueOf()
  )
  .map(async (journey) => ({
    journey,
    line: journeyLeadLine(journey),
    image: await journeyLeadImage(journey, posts, fragmentsById),
  }));
const heroCards = await Promise.all(hero);

const feedPosts = await Promise.all(
  posts.map(async (post) => ({
    post,
    image: await postLeadImage(post, fragmentsById),
  }))
);
---

<Base title="Feed">
  <p class="terms">
    An archive of things I'm exploring.
    <span class="q">Some of it goes nowhere.</span>
  </p>

  <p class="section-label">journeys</p>
  <div class="cards">
    {
      heroCards.map(({ journey, line, image }) => (
        <JourneyCard
          slug={journey.data.slug}
          title={journey.data.title}
          path={journey.data.path}
          status={journey.data.status}
          identityLabel={identityTitle.get(journey.data.identity) ?? journey.data.identity}
          line={line}
          image={image}
        />
      ))
    }
  </div>

  <p class="section-label">feed</p>
  <ul class="feed-list">
    {
      feedPosts.map(({ post, image }) => (
        <li class="feed-item">
          {image && (
            <img
              class="feed-thumb"
              src={image.src}
              width={image.width}
              height={image.height}
              loading="lazy"
              alt=""
              style={`transform: rotate(${tiltForId(post.data.slug)}deg)`}
            />
          )}
          <span class="feed-item__body">
            <a href={withBase(`/posts/${post.data.slug}/`)}>
              {post.data.title}
              {post.data.status === 'in_progress' && (
                <span class="inprogress">in progress</span>
              )}
            </a>
            <span class="meta">{dateLine(post.data.published)}</span>
            {post.data.journey && (
              <span class="meta">
                {' '}
                — <a href={withBase(`/journeys/${post.data.journey}/`)}>{post.data.journey}</a>
              </span>
            )}
          </span>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .feed-list { padding: 0; margin: 0; }
  .feed-item {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 0.9rem;
  }
  .feed-thumb {
    display: block;
    width: 44px;
    height: 44px;
    object-fit: cover;
    flex-shrink: 0;
  }
</style>