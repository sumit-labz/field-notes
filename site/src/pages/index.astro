---
// / — terms → journeys, most-recently-active first, each showing its
// newest post. The homepage IS the journeys list now; there is no separate
// flat post-by-post feed below it (see the Phase 2 homepage redesign).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import JourneyCard from '../components/JourneyCard.astro';
import {
  journeyLastActivity,
  journeyLeadLine,
  journeyLeadImage,
  journeyLeadPost,
  postExcerpt,
} from '../lib/content';

// Homepage curation: only the most recently active journeys, capped so the
// page stays a short, scannable list rather than growing without bound as
// the archive does.
const MAX_JOURNEYS = 6;

const identityEntries = await getCollection('identities');
const identityTitle = new Map(
  identityEntries.map((i) => [i.data.slug, i.data.title])
);

const journeys = await getCollection('journeys');
const posts = await getCollection('posts');
const fragments = await getCollection('fragments');
const fragmentsById = new Map(fragments.map((f) => [f.data.id, f]));

// Every journey gets one slot regardless of path — a daily practice journey
// no longer dominates the page the way it would in a post-by-post feed; it
// just occupies its one slot and moves to the top when it's active.
const ranked = journeys
  .slice()
  .sort(
    (a, b) =>
      journeyLastActivity(b, posts).valueOf() - journeyLastActivity(a, posts).valueOf()
  )
  .slice(0, MAX_JOURNEYS);

const cards = await Promise.all(
  ranked.map(async (journey) => {
    const leadPost = journeyLeadPost(journey, posts);
    return {
      journey,
      image: await journeyLeadImage(journey, posts, fragmentsById),
      postTitle: leadPost?.data.title ?? null,
      postSlug: leadPost?.data.slug ?? null,
      postInProgress: leadPost?.data.status === 'in_progress',
      // No post yet: fall back to the journey's own opening line so a brand
      // new journey isn't a blank card.
      line: leadPost ? postExcerpt(leadPost) : journeyLeadLine(journey),
    };
  })
);
---

<Base title="Feed">
  <p class="terms">
    An archive of things I'm exploring.
    <span class="q">Some of it goes nowhere.</span>
  </p>

  <p class="section-label">journeys</p>
  <div class="cards">
    {
      cards.map(({ journey, image, postTitle, postSlug, postInProgress, line }) => (
        <JourneyCard
          slug={journey.data.slug}
          title={journey.data.title}
          path={journey.data.path}
          status={journey.data.status}
          identitySlug={journey.data.identity}
          identityLabel={identityTitle.get(journey.data.identity) ?? journey.data.identity}
          image={image}
          postTitle={postTitle}
          postSlug={postSlug}
          postInProgress={postInProgress}
          line={line}
        />
      ))
    }
  </div>
</Base>
