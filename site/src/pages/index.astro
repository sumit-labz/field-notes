---
// / — journeys, most-recently-active first, each as a section: its Obsession
// + title as a header, then a capped grid of its own most recent posts as
// medium thumbnails with a short teaser. Gives the visitor something to
// actually read, not just one card per journey (see the Phase 2 homepage
// redesign — this replaced an earlier one-card-per-journey layout).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import JourneySectionHead from '../components/JourneySectionHead.astro';
import PostThumb from '../components/PostThumb.astro';
import {
  journeyLastActivity,
  journeyLeadLine,
  postsForJourney,
  postLeadMedia,
  postTeaser,
} from '../lib/content';
import { originFor } from '../lib/post-origin';

// Homepage curation: only the most recently active journeys, and only the
// most recent few posts per journey, so the page stays a bounded, scannable
// stream rather than growing without limit as the archive does.
const MAX_JOURNEYS = 6;
const POSTS_PER_JOURNEY = 3;

const identityEntries = await getCollection('identities');
const identityTitle = new Map(
  identityEntries.map((i) => [i.data.slug, i.data.title])
);

const journeys = await getCollection('journeys');
const posts = await getCollection('posts');
const fragments = await getCollection('fragments');
const fragmentsById = new Map(fragments.map((f) => [f.data.id, f]));

// Every journey gets ranked regardless of path — a daily practice journey no
// longer dominates the page the way it would in a flat post-by-post feed; it
// just occupies its one section and moves to the top when it's active.
// gesture-drawing-dailies is a high-frequency daily practice journey that
// would otherwise dominate the top of the page every time it's touched —
// it's pinned to the bottom of the ranking instead of competing on recency.
const PINNED_LAST = new Set(['gesture-drawing-dailies']);

// Pinned journeys sit at the bottom but are always shown: the MAX_JOURNEYS
// cap applies to the recency-ranked rest, never to the pinned ones (sorting
// them last and then slicing used to drop them once there were enough
// journeys to fill the cap).
const byRecency = (a: (typeof journeys)[number], b: (typeof journeys)[number]) =>
  journeyLastActivity(b, posts).valueOf() - journeyLastActivity(a, posts).valueOf();
const pinned = journeys.filter((j) => PINNED_LAST.has(j.data.slug));
const ranked = [
  ...journeys
    .filter((j) => !PINNED_LAST.has(j.data.slug))
    .sort(byRecency)
    .slice(0, MAX_JOURNEYS),
  ...pinned,
];

const sections = await Promise.all(
  ranked.map(async (journey) => {
    const journeyPosts = postsForJourney(journey, posts, {
      limit: POSTS_PER_JOURNEY,
      order: 'newest',
    });
    const postCards = await Promise.all(
      journeyPosts.map(async (post) => ({
        post,
        media: await postLeadMedia(post, fragmentsById),
        teaser: postTeaser(post),
      }))
    );
    return {
      journey,
      postCards,
      // No posts yet: fall back to the journey's own opening line so a
      // brand new journey still shows up as something, not an empty section.
      emptyLine: journeyPosts.length === 0 ? journeyLeadLine(journey) : null,
    };
  })
);
---

<Base title="Feed">
  <p class="terms" data-ink-write>
    An archive of things I'm exploring.
    <span class="q journey-title journey-title--struck" data-strike-seed="home-tagline">
      <span class="journey-title__text" data-strike-text>Some of it goes nowhere.</span>
      <svg class="strike-overlay" aria-hidden="true"></svg>
    </span>
  </p>

  {
    sections.map(({ journey, postCards, emptyLine }) => (
      <section class="journey-section">
        <JourneySectionHead
          slug={journey.data.slug}
          title={journey.data.title}
          status={journey.data.status}
          identitySlug={journey.data.identity}
          identityLabel={identityTitle.get(journey.data.identity) ?? journey.data.identity}
        />
        {postCards.length > 0 ? (
          <div class="post-grid">
            {postCards.map(({ post, media, teaser }) => (
              <PostThumb
                slug={post.data.slug}
                title={post.data.title}
                teaser={teaser}
                media={media}
                inProgress={post.data.status === 'in_progress'}
                origin={originFor(post.data)}
              />
            ))}
          </div>
        ) : (
          <p class="journey-section__empty">{emptyLine}</p>
        )}
      </section>
    ))
  }
</Base>

<script>
  import '../client/feed';
</script>
