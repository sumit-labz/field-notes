---
import '../styles/global.css';
import { withBase } from '../lib/url';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Instrument+Sans:wght@400;500&family=Space+Mono:wght@400;700&family=Caveat:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav>
      <a class="wordmark" href={withBase('/')}>field notes</a>
      <a href={withBase('/')}>feed</a>
      <a href={withBase('/identities')}>obsessions</a>
      <a href={withBase('/coordinates')}>notes to self</a>
      <a href={withBase('/about')}>about</a>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
