---
// The "made with" badge — a click-to-expand mark at the foot of every post,
// naming how much AI touched it on Sumit's self-editing-pass ladder. Collapsed
// it's a small pill ("[mic icon] Voice Note, <stage>"); expanded it opens a
// panel with this post's honest statement only (the full ladder was cut from
// every post as repeated noise). Native to Field Notes: its own tokens
// (--accent/--panel/--line) and fonts, so it sits in light or dark without
// restyling. Every made_with post began as a recorded voice note (see
// lib/post-origin.ts), so the pill always carries that mark.
import OriginGlyph from './OriginGlyph.astro';
import { ORIGIN_LABEL } from '../lib/post-origin';

interface Props {
  stage: 'raw' | 'self-edited' | 'feedback' | 'unaided';
}
const { stage } = Astro.props;

// Per-stage pill label + the honest statement, split so the accent phrase can
// carry the --accent colour (the "mirror, not a ghostwriter" beat).
const STAGES: Record<Props['stage'], { pill: string; glyph: string; before: string; accent: string; after: string }> = {
  raw: {
    pill: 'raw',
    glyph: '◉',
    before: 'This began as raw recorded voice — spoken from the unconscious, feeling intact. Only the mechanical typos were fixed; the rough edges stayed. AI was a ',
    accent: 'transcriber, not an editor',
    after: ': none of its wording is in these words — so a fumbled sentence here and there is all mine, kept on purpose.',
  },
  'self-edited': {
    pill: 'self-edited',
    glyph: '●',
    before: 'This began as raw recorded voice — spoken from the unconscious, feeling intact — and I hand-edited it. AI was a ',
    accent: 'mirror, not a ghostwriter',
    after: ': it pointed, I decided. None of its wording is in these words.',
  },
  feedback: {
    pill: 'with AI feedback',
    glyph: '◐',
    before: 'This began as raw recorded voice — spoken from the unconscious, feeling intact — and I hand-edited it with AI as a crutch. Where I took a phrasing it offered, ',
    accent: 'its words touched mine',
    after: '. The diagnosis was the tool’s; the choices were mine.',
  },
  unaided: {
    pill: 'unaided',
    glyph: '○',
    before: 'This began as raw recorded voice — spoken from the unconscious, feeling intact — and I edited it by my own eye alone. ',
    accent: 'No AI was in the loop',
    after: '. Where the practice is headed.',
  },
};

const s = STAGES[stage];
---

<details class="mw" data-stage={stage}>
  <summary class="mw__pill">
    <span class="mw__origin-icon" title={ORIGIN_LABEL.voice} aria-hidden="true">
      <OriginGlyph origin="voice" size={13} />
    </span>
    <span class="mw__dot" aria-hidden="true">{s.glyph}</span>
    <span class="mw__pilltext">{ORIGIN_LABEL.voice}, <b>{s.pill}</b></span>
    <span class="mw__chev" aria-hidden="true">⌄</span>
  </summary>
  <div class="mw__panel">
    <p class="mw__statement">{s.before}<em class="mw__accent">{s.accent}</em>{s.after}</p>
  </div>
</details>

<style>
  .mw {
    margin-top: 3rem;
  }

  /* Collapsed: a small pill you can see and click. */
  .mw__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
    list-style: none;
    color: var(--graphite);
    background: transparent;
  }
  .mw__pill::-webkit-details-marker { display: none; }
  .mw__origin-icon {
    display: inline-flex;
    color: var(--accent);
    line-height: 1;
  }
  .mw__dot {
    color: var(--accent);
    font-size: 0.7rem;
    line-height: 1;
  }
  .mw__pilltext {
    font-family: var(--font-body, sans-serif);
    font-size: 0.9rem;
  }
  .mw__pilltext b {
    font-family: var(--font-meta, 'Space Mono', monospace);
    font-weight: 700;
    color: var(--ink);
  }
  .mw__chev {
    margin-left: 0.15rem;
    font-size: 0.9rem;
    color: var(--ghost);
    /* instant flip, no decorative motion */
  }
  .mw[open] .mw__chev { transform: rotate(180deg); }

  /* Expanded: the panel. */
  .mw__panel {
    margin-top: 0.7rem;
    max-width: 42rem;
    padding: 1.5rem 1.6rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  .mw__statement {
    margin: 0;
    font-family: var(--font-body, sans-serif);
    font-size: 1.14rem;
    line-height: 1.55;
    color: var(--ink);
  }
  .mw__accent {
    font-style: italic;
    color: var(--accent);
  }
</style>
