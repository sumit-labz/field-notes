---
// The "made with" colophon — a visible mark at the foot of every post stating
// how much AI touched it, from Sumit's self-editing-pass practice. Always shown
// (not hidden behind a click): the stage, an honest one-liner, and the four-rung
// scale with the current rung lit. Native to Field Notes — its own tokens and
// fonts, a hairline rule to set it apart as a footer block.
//
// Ladder, least- to most-AI-in-the-wording:
//   ◉ raw · ● self-edited · ◐ feedback · ○ unaided
interface Props {
  stage: 'raw' | 'self-edited' | 'feedback' | 'unaided';
}
const { stage } = Astro.props;

const LADDER = [
  { key: 'raw', glyph: '◉', label: 'raw' },
  { key: 'self-edited', glyph: '●', label: 'self-edited' },
  { key: 'feedback', glyph: '◐', label: 'feedback' },
  { key: 'unaided', glyph: '○', label: 'unaided' },
] as const;

const STATEMENTS: Record<Props['stage'], string> = {
  raw: 'Recorded voice, transcribed. Only mechanical mistakes — typos, obvious slips, paragraph breaks — were fixed. No craft edit, no rewording, none of the AI’s words entered the text.',
  'self-edited': 'Recorded voice, hand-edited by me for craft using an AI diagnostic tool as a crutch. I took only its eye: every word here is mine; where it pointed, I did the fixing.',
  feedback: 'Recorded voice, hand-edited by me for craft using an AI diagnostic tool as a crutch. Where I took a phrasing it offered, the AI touched the words. The diagnosis was the tool’s; the choices were mine. I’m learning to need it less.',
  unaided: 'Written and edited entirely by me. No AI in the loop.',
};

const current = LADDER.find((r) => r.key === stage)!;
---

<section class="madewith" data-stage={stage} aria-label="How much AI touched this piece">
  <div class="madewith__head">
    <span class="madewith__glyph" aria-hidden="true">{current.glyph}</span>
    <span class="madewith__label">made with</span>
    <span class="madewith__stage">{current.label}</span>
  </div>
  <p class="madewith__statement">{STATEMENTS[stage]}</p>
  <ol class="madewith__scale" aria-label="AI-usage scale, least to most AI in the wording">
    {
      LADDER.map((rung) => (
        <li class:list={['madewith__rung', { 'is-current': rung.key === stage }]}>
          <span class="madewith__rung-glyph" aria-hidden="true">{rung.glyph}</span>
          <span>{rung.label}</span>
        </li>
      ))
    }
  </ol>
</section>

<style>
  /* A distinct footer block, set off by a hairline rule. Visible by design —
     this is the honesty mark; a reader should be able to see it without hunting.
     Quiet in tone, but legible, never invisible. */
  .madewith {
    margin-top: 3rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .madewith__head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .madewith__glyph {
    color: var(--ink);
    font-size: 1.05rem;
    line-height: 1;
    transform: translateY(0.06em);
  }
  .madewith__label {
    font-family: var(--font-structure, 'Archivo', sans-serif);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.72rem;
    color: var(--graphite);
  }
  .madewith__stage {
    font-family: 'Space Mono', monospace;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .madewith__statement {
    margin: 0.8rem 0 0;
    max-width: 52ch;
    font-family: 'Space Mono', monospace;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--graphite);
  }
  /* The scale: current rung lit, the others faint but still readable. */
  .madewith__scale {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.3rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .madewith__rung {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    font-family: var(--font-structure, 'Archivo', sans-serif);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    font-size: 0.62rem;
    color: var(--ghost);
  }
  .madewith__rung-glyph {
    font-size: 0.78rem;
    line-height: 1;
    transform: translateY(0.05em);
    color: var(--ghost);
  }
  .madewith__rung.is-current {
    color: var(--ink);
  }
  .madewith__rung.is-current .madewith__rung-glyph {
    color: var(--ink);
  }
</style>
