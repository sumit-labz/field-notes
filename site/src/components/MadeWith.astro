---
// The "made with" badge — a click-to-expand mark at the foot of every post,
// naming how much AI touched it on Sumit's self-editing-pass ladder. Collapsed
// it's a small pill ("Raw voice, <stage>"); expanded it opens a panel with an
// honest statement, the four-rung ladder (current lit), and a note on the
// practice. Native to Field Notes: its own tokens (--accent/--panel/--line) and
// fonts, so it sits in light or dark without restyling.
interface Props {
  stage: 'raw' | 'self-edited' | 'feedback' | 'unaided';
}
const { stage } = Astro.props;

// Per-stage pill label + the honest statement, split so the accent phrase can
// carry the --accent colour (the "mirror, not a ghostwriter" beat).
const STAGES: Record<Props['stage'], { pill: string; glyph: string; before: string; accent: string; after: string }> = {
  raw: {
    pill: 'raw',
    glyph: '◉',
    before: 'This began as raw recorded voice — spoken from the unconscious, feeling intact. Only mechanical mistakes were fixed. AI was a ',
    accent: 'transcriber, not an editor',
    after: ': none of its wording is in these words.',
  },
  'self-edited': {
    pill: 'self-edited',
    glyph: '●',
    before: 'This began as raw recorded voice — spoken from the unconscious, feeling intact — and I hand-edited it. AI was a ',
    accent: 'mirror, not a ghostwriter',
    after: ': it pointed, I decided. None of its wording is in these words.',
  },
  feedback: {
    pill: 'with AI feedback',
    glyph: '◐',
    before: 'This began as raw recorded voice — spoken from the unconscious, feeling intact — and I hand-edited it with AI as a crutch. Where I took a phrasing it offered, ',
    accent: 'its words touched mine',
    after: '. The diagnosis was the tool’s; the choices were mine.',
  },
  unaided: {
    pill: 'unaided',
    glyph: '○',
    before: 'This began as raw recorded voice — spoken from the unconscious, feeling intact — and I edited it by my own eye alone. ',
    accent: 'No AI was in the loop',
    after: '. Where the practice is headed.',
  },
};

const SCALE = [
  { key: 'raw', glyph: '◉', label: 'Raw', sub: 'Recorded voice, transcribed. Only mechanical fixes.' },
  { key: 'self-edited', glyph: '●', label: 'Self-edited', sub: 'AI as a mirror. Its eye, my words.' },
  { key: 'feedback', glyph: '◐', label: 'With AI feedback', sub: 'The crutch. A few phrasings adopted.' },
  { key: 'unaided', glyph: '○', label: 'Unaided', sub: 'No AI. Where the practice matures to.' },
] as const;

const NOTE = 'The badge names where a piece sits on the ladder I’m climbing — from leaning on the tool toward needing none of it.';
const s = STAGES[stage];
---

<details class="mw" data-stage={stage}>
  <summary class="mw__pill">
    <span class="mw__dot" aria-hidden="true">{s.glyph}</span>
    <span class="mw__pilltext">Raw voice, <b>{s.pill}</b></span>
    <span class="mw__chev" aria-hidden="true">⌄</span>
  </summary>
  <div class="mw__panel">
    <p class="mw__statement">{s.before}<em class="mw__accent">{s.accent}</em>{s.after}</p>
    <hr class="mw__rule" />
    <ol class="mw__scale">
      {
        SCALE.map((rung) => (
          <li class:list={['mw__rung', { 'is-current': rung.key === stage }]}>
            <span class="mw__rung-dot" aria-hidden="true">{rung.glyph}</span>
            <span class="mw__rung-text">
              <b class="mw__rung-label">{rung.label}</b>
              <span class="mw__rung-sub">{rung.sub}</span>
            </span>
          </li>
        ))
      }
    </ol>
    <hr class="mw__rule" />
    <p class="mw__note">{NOTE}</p>
  </div>
</details>

<style>
  .mw {
    margin-top: 3rem;
  }

  /* Collapsed: a small pill you can see and click. */
  .mw__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
    list-style: none;
    color: var(--graphite);
    background: transparent;
  }
  .mw__pill::-webkit-details-marker { display: none; }
  .mw__dot {
    color: var(--accent);
    font-size: 0.7rem;
    line-height: 1;
  }
  .mw__pilltext {
    font-family: var(--font-body, sans-serif);
    font-size: 0.9rem;
  }
  .mw__pilltext b {
    font-family: var(--font-meta, 'Space Mono', monospace);
    font-weight: 700;
    color: var(--ink);
  }
  .mw__chev {
    margin-left: 0.15rem;
    font-size: 0.9rem;
    color: var(--ghost);
    /* instant flip, no decorative motion */
  }
  .mw[open] .mw__chev { transform: rotate(180deg); }

  /* Expanded: the panel. */
  .mw__panel {
    margin-top: 0.7rem;
    max-width: 42rem;
    padding: 1.5rem 1.6rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  .mw__statement {
    margin: 0;
    font-family: var(--font-body, sans-serif);
    font-size: 1.14rem;
    line-height: 1.55;
    color: var(--ink);
  }
  .mw__accent {
    font-style: italic;
    color: var(--accent);
  }
  .mw__rule {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 1.25rem 0;
  }

  .mw__scale {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .mw__rung {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
  }
  .mw__rung-dot {
    flex: none;
    width: 1rem;
    font-size: 0.85rem;
    line-height: 1.2;
    color: var(--ghost);
  }
  .mw__rung-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .mw__rung-label {
    font-family: var(--font-meta, 'Space Mono', monospace);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--graphite);
  }
  .mw__rung-sub {
    font-family: var(--font-meta, 'Space Mono', monospace);
    font-size: 0.78rem;
    color: var(--ghost);
  }
  /* the current rung lights up in the accent colour */
  .mw__rung.is-current .mw__rung-dot,
  .mw__rung.is-current .mw__rung-label {
    color: var(--accent);
  }

  .mw__note {
    margin: 0;
    font-family: var(--font-meta, 'Space Mono', monospace);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--ghost);
  }
</style>
