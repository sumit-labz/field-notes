---
// site/src/components/PostThumb.astro
// One post, shown as a medium thumbnail + title + a short teaser (not the
// full excerpt) — used both on the homepage (grouped under a journey) and
// on the journey detail page's post grid. A single destination (the post),
// so this is a plain wrapping <a>, unlike JourneyCard.
//
// A video thumbnail is static (paused, first frame) until the viewer engages
// with it: hover-to-play on a device with real hover (desktop), or autoplay
// when scrolled into view otherwise (touch) — see client/thumb-video.ts. This
// is the one deliberate exception to the site's "no motion" default.
import type { LeadMedia } from '../lib/content';
import { withBase } from '../lib/url';
import { tiltForId } from '../lib/rotation';

interface Props {
  slug: string;
  title: string;
  teaser: string;
  media: LeadMedia | null;
  inProgress: boolean;
  // Waypoint number along the journey (oldest-first) — only passed on the
  // journey detail page, where the grid shows the whole arc in order and
  // should read as steps being traversed, not on the homepage where only
  // a recent few posts show (partial, not the full arc).
  step?: number;
}
const { slug, title, teaser, media, inProgress, step } = Astro.props;
const tilt = tiltForId(slug);
---

<a class="post-thumb" href={withBase(`/posts/${slug}/`)}>
  <div class="post-thumb__img-wrap">
    {
      media?.kind === 'image' ? (
        <img
          class="post-thumb__img"
          src={media.src}
          width={media.width}
          height={media.height}
          loading="lazy"
          alt=""
          style={`transform: rotate(${tilt}deg)`}
        />
      ) : media?.kind === 'video' ? (
        <video
          class="post-thumb__img post-thumb__video"
          data-thumb-video
          src={media.src}
          muted
          loop
          playsinline
          preload="metadata"
          style={`transform: rotate(${tilt}deg)`}
        />
      ) : (
        <div class="post-thumb__img post-thumb__img--empty" />
      )
    }
    {step && <span class="post-thumb__step font-mono">{String(step).padStart(2, '0')}</span>}
  </div>
  <div class="post-thumb__body">
    <p class="post-thumb__title">
      {title}
      {inProgress && <span class="inprogress">in progress</span>}
    </p>
    {teaser && <p class="post-thumb__teaser">{teaser}</p>}
  </div>
</a>

<script>
  import '../client/thumb-video';
</script>
