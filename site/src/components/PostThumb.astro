---
// site/src/components/PostThumb.astro
// One post, shown as a piece of physical evidence on the studio table rather
// than a card in a grid: a taped print, a photocopy, an index card, or a
// clipping with its title set over the image. Every irregularity (which
// material, the lean, where the tape lands) is seeded from the slug — never
// Math.random() — so the wall looks the same on every visit and only changes
// when new material arrives.
//
// A video thumbnail is static (paused, first frame) until the viewer engages
// with it: hover-to-play on a device with real hover (desktop), or autoplay
// when scrolled into view otherwise (touch) — see client/thumb-video.ts.
import type { LeadMedia } from '../lib/content';
import { withBase } from '../lib/url';
import { hashString } from '../lib/hash';
import type { PostOrigin } from '../lib/post-origin';

export type ArtifactVariant = 'print' | 'xerox' | 'card' | 'clip';

interface Props {
  slug: string;
  title: string;
  teaser: string;
  media: LeadMedia | null;
  inProgress: boolean;
  origin: PostOrigin;
  // Waypoint number along the journey (oldest-first) — journey page only.
  step?: number;
  // Which material this post is printed on. Omitted: picked from the slug.
  variant?: ArtifactVariant;
  // Archive label printed beside it ("fig. 04", a date).
  fig?: string;
  date?: string;
  // Hide the teaser (dense collage slots).
  quiet?: boolean;
}
const { slug, title, teaser, media, inProgress, origin, step, fig, date, quiet = false } = Astro.props;

const h = Math.abs(hashString(`${slug}:artifact`));
const materials: ArtifactVariant[] = ['print', 'xerox', 'print', 'clip'];
// No image: it can only ever be an index card — honest, never a placeholder.
const variant: ArtifactVariant = !media ? 'card' : (Astro.props.variant ?? materials[h % materials.length]);
// The lean it rests at: most sit nearly straight, a few lean further.
const lean = (((h >> 3) % 100) / 100 - 0.5) * (h % 5 === 0 ? 4.2 : 1.8);
// The angle it falls in at when the wall reveals it (see .art reveal).
const drop = ((h & 1 ? 1 : -1) * (2 + ((h >> 5) % 300) / 100)).toFixed(2);
// Tape: where along the top edge, and its own skew.
const tapeX = 18 + ((h >> 7) % 55);
const tapeR = (((h >> 9) % 14) - 7).toFixed(1);
const second = (h >> 11) % 3 === 0; // a second strip, now and then
const label = fig ?? (step ? `no. ${String(step).padStart(2, '0')}` : null);
const originMark = origin === 'voice' ? 'voice note' : 'written';
---

<a
  class:list={['art', `art--${variant}`, { 'art--quiet': quiet }]}
  href={withBase(`/posts/${slug}/`)}
  style={`--lean: ${lean.toFixed(2)}deg; --drop: ${drop}deg; --tape-x: ${tapeX}%; --tape-r: ${tapeR}deg`}
  data-reveal
>
  {variant !== 'card' && <span class="art__tape" aria-hidden="true" />}
  {second && variant === 'print' && <span class="art__tape art__tape--b" aria-hidden="true" />}
  {variant === 'xerox' && <span class="art__staple" aria-hidden="true" />}

  {
    variant !== 'card' && (
      <span class="art__plate">
        {media?.kind === 'image' ? (
          <img class="art__img" src={media.src} width={media.width} height={media.height} loading="lazy" alt="" />
        ) : media?.kind === 'video' ? (
          <video class="art__img" data-thumb-video src={media.src} muted loop playsinline preload="metadata" />
        ) : null}
        {variant === 'clip' && <span class="art__over"><span>{title}</span></span>}
      </span>
    )
  }

  <span class="art__body">
    {
      variant === 'card' && (
        <span class="art__cardhead" aria-hidden="true">
          <span>{label ?? 'note'}</span>
          <span>{date}</span>
        </span>
      )
    }
    {variant !== 'clip' && (
      <span class="art__title">
        {title}
      </span>
    )}
    {!quiet && teaser && <span class="art__teaser">{teaser}</span>}
    <span class="art__meta">
      {variant !== 'card' && label && <span class="art__fig">{label}</span>}
      {variant !== 'card' && date && <span>{date}</span>}
      <span>{originMark}</span>
      {inProgress && <span class="art__wip">in progress</span>}
    </span>
  </span>
</a>

<script>
  import '../client/thumb-video';
</script>
