---
import type { CollectionEntry } from 'astro:content';
import { formatCapturedAt } from '../lib/dates';
import { tiltForId } from '../lib/rotation';
import { mediaUrl } from '../lib/media-url';
import { isLocalMedia, localMediaUrl } from '../lib/local-media';
import { getImageDimensions, getLocalImageDimensions } from '../lib/image-dimensions';
import { gradedOrOriginal } from '../lib/content';
import { renderMarkdown } from '../lib/markdown';

interface Props {
  fragment: CollectionEntry<'fragments'>;
}

const { fragment } = Astro.props;
const { data, body } = fragment;
const tilt = tiltForId(data.id);
const caption = body?.trim() ?? '';

// A markdown fragment's body IS the document — a process doc or spec worth
// dropping into a post as its own object, not folded into the post's prose.
// Rendered as real markdown (not the paragraph-splitter post bodies use),
// collapsed behind a native <details> so it doesn't dominate the post; the
// summary is the doc's own first heading, so it says what it is before
// anyone opens it.
const isMarkdown = data.type === 'markdown';
const markdownHtml = isMarkdown ? renderMarkdown(body ?? '') : '';
const markdownTitle = isMarkdown
  ? ((body ?? '').match(/^#\s+(.+)$/m)?.[1]?.trim() ?? 'process document')
  : '';

// Audio/video media (SPEC.md §4) isn't served or playable on the static site
// yet — only image keys are rendered here. An image key is EITHER an R2
// object key (most photos) OR a repo-relative local path (photos captured via
// the web inbox's record/upload/paste tool — see lib/local-media.ts).
const imageIndexes = (data.media ?? [])
  .map((k, i) => (/\.(webp|jpe?g|png|gif|avif)$/i.test(k) ? i : -1))
  .filter((i) => i !== -1);

const photos = (
  await Promise.all(
    imageIndexes.map(async (index) => {
      // A graded copy (if this photo has one) always wins over the
      // original — see content/config.ts's `graded` field.
      const key = gradedOrOriginal(fragment, index);
      try {
        if (isLocalMedia(key)) {
          const src = localMediaUrl(key);
          if (!src) return null;
          return { src, ...getLocalImageDimensions(key) };
        }
        const src = mediaUrl(key);
        return { src, ...(await getImageDimensions(src)) };
      } catch {
        // Missing/unreadable media shouldn't fail the whole build — skip it.
        return null;
      }
    })
  )
).filter((p): p is { src: string; width: number; height: number } => p !== null);
---

<figure>
  <figcaption class="meta">
    {formatCapturedAt(data.captured_at)} · {data.type}
    {data.spark && <span> · spark</span>}
  </figcaption>
  {
    isMarkdown ? (
      <details class="md-fragment">
        <summary>{markdownTitle}</summary>
        <div class="md-fragment-body" set:html={markdownHtml} />
      </details>
    ) : (
      <Fragment>
        {photos.length > 0 && (
          <div class="fragment-photos">
            {photos.map((photo) => (
              <img
                class="fragment-photo"
                src={photo.src}
                width={photo.width}
                height={photo.height}
                loading="lazy"
                alt={caption}
                style={`transform: rotate(${tilt}deg)`}
              />
            ))}
          </div>
        )}
        {caption && <p>{caption}</p>}
      </Fragment>
    )
  }
</figure>
