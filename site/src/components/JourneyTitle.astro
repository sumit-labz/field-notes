---
interface Props {
  title: string;
  status: 'active' | 'paused' | 'abandoned' | 'completed';
  as?: 'span' | 'h1';
  /** Stable id (the journey slug) the strike wobble is seeded from. */
  seed: string;
  /** The name it started under — the old title tears away to show this one. */
  was?: string;
}

const { title, status, as = 'span', seed, was } = Astro.props;
const Tag = as;
---

{
  was ? (
    <Tag class="journey-title journey-title--torn" data-tear>
      <span class="tear__new">{title}</span>
      <span class="tear__old tear__old--top" aria-hidden="true">{was}</span>
      <span class="tear__old tear__old--bottom" aria-hidden="true">{was}</span>
      <span class="sr-only"> (formerly {was})</span>
    </Tag>
  ) : status === 'paused' ? (
    <Tag class="journey-title">[ {title} ]</Tag>
  ) : status === 'completed' ? (
    <Tag class="journey-title">
      {title}
      <svg class="tick" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <rect x="2" y="3" width="14" height="14" />
        <path d="M5,10.5 L8.5,14 L15,6" />
      </svg>
    </Tag>
  ) : status === 'abandoned' ? (
    <Tag class="journey-title journey-title--struck" data-strike-seed={seed}>
      <span class="journey-title__text" data-strike-text>
        {title}
      </span>
      <svg class="strike-overlay" aria-hidden="true" focusable="false" />
    </Tag>
  ) : (
    <Tag class="journey-title">{title}</Tag>
  )
}

<script>
  import '../client/strike-through';
  import '../client/tear';
</script>
