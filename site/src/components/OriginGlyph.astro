---
// site/src/components/OriginGlyph.astro
// Hand-authored icon for the two post-origin categories — a mic for a post
// that began as recorded voice (see lib/post-origin.ts), a pen for one typed
// by hand from the start. Same props shape as ModeGlyph.astro.
import type { PostOrigin } from '../lib/post-origin';

interface Props {
  origin: PostOrigin;
  size?: number;
  color?: string;
}
const { origin, size = 16, color = 'currentColor' } = Astro.props;
---

{origin === 'voice' ? (
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <g fill="none" stroke={color} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <rect x="9" y="2.5" width="6" height="11" rx="3" />
      <path d="M5 11.5 a7 7 0 0 0 14 0" />
      <path d="M12 18.5 L12 21.5 M8.5 21.5 L15.5 21.5" />
    </g>
  </svg>
) : (
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <g fill="none" stroke={color} stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 20 L4.9 16.4 L15.5 5.8 a1.9 1.9 0 0 1 2.7 0 l1 1 a1.9 1.9 0 0 1 0 2.7 L8.6 19.1 Z" />
      <path d="M13.7 7.6 L16.4 10.3" />
    </g>
  </svg>
)}
