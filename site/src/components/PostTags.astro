---
// A post's tags, set beside the MadeWith pill: plain Space Mono links to each
// tag's page. Graphite, underline only — no yellow (yellow is never UI).
import { tagBySlug } from '../lib/tags';
import { withBase } from '../lib/url';

interface Props {
  tags: string[];
}

const tags = Astro.props.tags.map(tagBySlug).filter((t) => t !== undefined);
---

{
  tags.length > 0 && (
    <ul class="post-tags" aria-label="Tags">
      {tags.map((t) => (
        <li>
          <a href={withBase(`/tags/${t.slug}/`)}>#{t.label}</a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .post-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-meta);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }
  /* Stamped labels: square ink border, padded to the MadeWith pill's height
     so the slip reads as one line. Hover is a plain underline — no motion. */
  .post-tags a {
    display: inline-flex;
    align-items: center;
    box-sizing: border-box;
    min-height: 2.55rem; /* the MadeWith pill's height, so they sit level */
    padding: 0 0.75rem;
    border: 1.5px solid var(--ink);
    color: var(--ink);
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
  }
  .post-tags a:hover {
    text-decoration: underline;
  }
</style>
