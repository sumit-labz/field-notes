---
// site/src/components/ModeGlyph.astro
// Placeholder marks for the three modes — IMPLEMENTATION-SPEC stage 6. These
// are stand-ins (as in the design mockups); real scanned hand replaces them
// later, but the *proportions and placement* are fixed here. Never animated.
interface Props {
  path: 'practice' | 'learn' | 'create';
  size?: number;
  color?: string;
}
const { path, size = 26, color = 'var(--ink)' } = Astro.props;
---

{path === 'practice' ? (
  <svg width={size} height={Math.round(size * 0.7)} viewBox="0 0 30 22" aria-hidden="true" focusable="false">
    <g stroke={color} stroke-width="1.4" fill="none" stroke-linecap="round">
      <path d="M4 4 L4 18 M10 3 L10 19 M16 4 L16 18 M22 3 L22 19" />
    </g>
  </svg>
) : path === 'learn' ? (
  <svg width={size} height={Math.round(size * 0.7)} viewBox="0 0 30 22" aria-hidden="true" focusable="false">
    <path d="M3 15 C10 13 20 17 27 14" stroke={color} stroke-width="1.6" fill="none" stroke-linecap="round" />
    <path d="M6 15 L6 9 M6 9 L9 9" stroke="var(--graphite)" stroke-width="1.2" fill="none" />
  </svg>
) : (
  <svg width={size} height={Math.round(size * 0.7)} viewBox="0 0 30 22" aria-hidden="true" focusable="false">
    <rect x="6" y="4" width="16" height="15" fill={color} />
    <path d="M4 6 L24 3" stroke={color} stroke-width="1.3" fill="none" />
  </svg>
)}