---
// site/src/components/PostOriginBadge.astro
// A small icon + native-tooltip badge marking which of the two post
// categories a post is (see lib/post-origin.ts): Voice Note (transcribed
// from a spoken recording) or Written (typed by hand). Shared by the grid
// card (PostThumb) and the post page itself so the mark reads identically
// everywhere it shows up.
import OriginGlyph from './OriginGlyph.astro';
import { ORIGIN_LABEL, ORIGIN_TOOLTIP, type PostOrigin } from '../lib/post-origin';

interface Props {
  origin: PostOrigin;
  size?: number;
  class?: string;
}
const { origin, size = 16, class: className = '' } = Astro.props;
---

<span class={`post-origin ${className}`} title={ORIGIN_TOOLTIP[origin]} data-origin={origin}>
  <OriginGlyph origin={origin} size={size} />
  <span class="post-origin__sr">{ORIGIN_LABEL[origin]}</span>
</span>

<style>
  .post-origin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--graphite, currentColor);
  }
  .post-origin[data-origin='voice'] {
    color: var(--accent, currentColor);
  }
  .post-origin__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
