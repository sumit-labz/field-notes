# scripts/ingest.py — see SPEC.md §4 for what each of these does and how to
# obtain it. Never commit real values here. In GitHub Actions these come from
# repository secrets (Settings → Secrets and variables → Actions), not from
# this file — this file is only a local-dev convenience.

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=
R2_BUCKET=

# Used by the site build (site/.env.example), not by ingest.py — listed here
# too since it's part of the same R2 setup.
R2_PUBLIC_BASE=
